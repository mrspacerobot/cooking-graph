#!/usr/bin/env python3
"""candidates: list pairs of foods that share a group or a dish part and have no stand-in row yet. It writes nothing.

./candidates                      how many open pairs each group holds
./candidates --group group/pulses the open pairs of one group
./candidates --part-options       the open pairs found in dish and preparation parts
"""

import argparse
import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from tools import candidates, check  # noqa: E402

parser = argparse.ArgumentParser(prog="candidates", description="Pairs worth a stand-in row. A pair may not be a good swap.")
parser.add_argument("--group", help="list the open pairs of this group id")
parser.add_argument("--part-options", action="store_true", help="list the open pairs found in parts")
args = parser.parse_args()

things, issues = check.read_repository(ROOT)
if issues:
    print("candidates: ./check finds %d issues" % len(issues), file=sys.stderr)
    sys.exit(1)
pairs = candidates.find(things)
if args.group or args.part_options:
    lines = candidates.listing(pairs, group=args.group, part_options=args.part_options)
    print("\n".join(lines))
    print("candidates: %d pairs listed. A pair may be a poor swap; decide it in a context." % len(lines))
else:
    print("\n".join(candidates.summary(pairs)))
