{
  "id": "recipe/aloo-gobi",
  "tier": "drafted",
  "names": {"en": "Aloo gobi"},
  "aliases": {},
  "makes": "dish/aloo-gobi",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {
      "thing": "ingredient/potato",
      "amount": {"value": 400, "unit": "gram"},
      "forms": ["form/peeled", "form/large-pieces"],
      "part": "potato"
    },
    {
      "thing": "ingredient/cauliflower",
      "amount": {"value": 500, "unit": "gram"},
      "forms": ["form/large-pieces"],
      "part": "cauliflower"
    },
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/diced"], "part": "onion"},
    {
      "thing": "ingredient/tomato",
      "amount": {"value": 2, "unit": "piece"},
      "forms": ["form/chopped"],
      "part": "tomato"
    },
    {"thing": "ingredient/ginger", "amount": {"value": 15, "unit": "gram"}, "forms": ["form/minced"], "part": "ginger"},
    {
      "thing": "ingredient/green-chilli",
      "amount": {"value": 2, "unit": "piece"},
      "forms": ["form/sliced"],
      "part": "green-chilli"
    },
    {"thing": "ingredient/oil", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "oil"},
    {"thing": "ingredient/cumin", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "cumin"},
    {"thing": "ingredient/turmeric", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "turmeric"},
    {
      "thing": "ingredient/red-chilli-powder",
      "amount": {"value": 1, "unit": "teaspoon"},
      "forms": [],
      "part": "chilli-powder"
    },
    {"thing": "ingredient/amchur", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "amchur"},
    {
      "thing": "preparation/garam-masala",
      "amount": {"value": 1, "unit": "teaspoon"},
      "forms": [],
      "part": "garam-masala"
    },
    {"thing": "ingredient/salt", "amount": {"value": 1.5, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {
      "thing": "ingredient/coriander-leaf",
      "amount": {"value": 10, "unit": "gram"},
      "forms": ["form/chopped"],
      "part": "coriander"
    }
  ],
  "equipment": ["equipment/stovetop", "equipment/saute-pan", "equipment/wooden-spoon"],
  "steps": [
    {
      "technique": "technique/temper-spices-in-hot-fat",
      "works_on": ["ingredient/cumin"],
      "with": ["ingredient/oil"],
      "text": "Heat the {oil} in a wide pan until a {cumin} seed sizzles at once. Add the {cumin} and let it darken a shade.",
      "time": {"from": 1, "to": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fry-masala-base",
      "works_on": ["ingredient/onion", "ingredient/tomato"],
      "with": [
        "ingredient/ginger", "ingredient/green-chilli", "ingredient/turmeric", "ingredient/red-chilli-powder",
        "ingredient/oil"
      ],
      "text": "Add the {onion}, the {ginger} and the {green-chilli} and cook until the {onion} is golden. Stir in the {turmeric} and the chilli powder for a moment, then add the {tomato} and cook, mashing it down, until the fat shows at the edge of the paste.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-a-dry-vegetable-dish",
      "works_on": ["ingredient/potato", "ingredient/cauliflower"],
      "with": ["ingredient/salt"],
      "text": "Add the {potato} and the {cauliflower} with the {salt} and stir to coat them. Cover the pan and cook over a low heat, stirring gently now and then, with no water added, until the pieces are tender. Take off the lid for the end of the cooking so that any moisture goes.",
      "time": {"from": 20, "to": 30, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/cauliflower"],
      "with": ["ingredient/amchur", "preparation/garam-masala", "ingredient/salt"],
      "text": "Off the heat, sprinkle in the sour {amchur} and the {garam-masala}, stir gently, and taste. Add a little more {salt} if it needs it.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/garnish",
      "works_on": ["ingredient/potato"],
      "with": ["ingredient/coriander-leaf"],
      "text": "Scatter the {coriander} over the dish and serve it hot.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
