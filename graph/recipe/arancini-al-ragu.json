{
  "id": "recipe/arancini-al-ragu",
  "tier": "drafted",
  "names": {"en": "Arancini al ragu"},
  "aliases": {},
  "makes": "dish/arancini",
  "yields": {"value": 6, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/butter", "amount": {"value": 30, "unit": "gram"}, "forms": [], "part": "fat"},
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/minced"], "part": "onion"},
    {"thing": "ingredient/arborio-rice", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "rice"},
    {"thing": "ingredient/white-wine", "amount": {"value": 100, "unit": "millilitre"}, "forms": [], "part": "wine"},
    {"thing": "ingredient/chicken-stock", "amount": {"value": 1.2, "unit": "litre"}, "forms": [], "part": "stock"},
    {"thing": "ingredient/saffron", "amount": {"value": 1, "unit": "pinch"}, "forms": [], "part": "saffron"},
    {"thing": "ingredient/butter", "amount": {"value": 40, "unit": "gram"}, "forms": [], "part": "finish"},
    {
      "thing": "ingredient/parmesan",
      "amount": {"value": 80, "unit": "gram"},
      "forms": ["form/grated"],
      "part": "cheese"
    },
    {"thing": "ingredient/salt", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "preparation/ragu", "amount": {"value": 250, "unit": "gram"}, "forms": [], "part": "ragu"},
    {"thing": "ingredient/peas", "amount": {"value": 100, "unit": "gram"}, "forms": [], "part": "peas"},
    {
      "thing": "ingredient/mozzarella",
      "amount": {"value": 150, "unit": "gram"},
      "forms": ["form/diced"],
      "part": "centre"
    },
    {"thing": "ingredient/flour", "amount": {"value": 60, "unit": "gram"}, "forms": [], "part": "flour"},
    {"thing": "ingredient/egg", "amount": {"value": 3, "unit": "piece"}, "forms": [], "part": "egg"},
    {"thing": "preparation/breadcrumbs", "amount": {"value": 200, "unit": "gram"}, "forms": [], "part": "crumbs"},
    {"thing": "ingredient/sunflower-oil", "amount": {"value": 1.5, "unit": "litre"}, "forms": [], "part": "oil"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/saute-pan", "equipment/saucepan", "equipment/dutch-oven", "equipment/wooden-spoon",
    "equipment/ladle", "equipment/baking-sheet", "equipment/mixing-bowl", "equipment/slotted-spoon",
    "equipment/thermometer", "equipment/wire-rack", "equipment/chefs-knife", "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/infuse",
      "works_on": ["ingredient/chicken-stock"],
      "with": ["ingredient/saffron"],
      "text": "Warm the stock in a saucepan until it steams, drop in the saffron and leave it to turn a deep gold. Keep the stock hot beside the risotto pan.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion"],
      "with": ["ingredient/butter", "ingredient/salt"],
      "text": "Soften the onion in the fat in a wide, heavy pan over low heat, with a little salt, until it is soft and glassy and has taken no colour.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/toast-rice",
      "works_on": ["ingredient/arborio-rice"],
      "with": ["ingredient/white-wine", "ingredient/butter"],
      "text": "Tip the dry rice into the onion and stir over medium heat until the edges of the grains turn translucent and the rice is hot. Pour in the wine and stir until it has been taken up.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/add-stock-gradually",
      "works_on": ["ingredient/arborio-rice"],
      "with": ["ingredient/chicken-stock", "ingredient/saffron"],
      "text": "Add the hot saffron stock a ladle at a time, stirring, and give each ladle time to be taken up before the next goes in. Stop when the grains are tender with a firm bite at the centre and the rice is thick and holds a trail, thicker than a risotto for eating.",
      "time": {"from": 16, "to": 18, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/mantecare",
      "works_on": ["ingredient/arborio-rice"],
      "with": ["ingredient/butter", "ingredient/parmesan", "ingredient/salt"],
      "text": "Take the pan off the heat. Beat in the cold butter and the cheese until the rice is glossy and clings together. Taste, and add salt if it needs it.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/peas"],
      "with": ["preparation/ragu"],
      "text": "Warm the ragu in a small pan, add the peas and let them cook gently until they are tender and the ragu is thick enough to hold on a spoon. Leave it to go cold.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/shape-a-stuffed-rice-ball",
      "works_on": ["ingredient/arborio-rice"],
      "with": [
        "preparation/ragu", "ingredient/peas", "ingredient/mozzarella", "ingredient/flour", "ingredient/egg",
        "preparation/breadcrumbs"
      ],
      "text": "Spread the risotto thin on a tray, let it cool right down and chill it until it is stiff. With wet hands, press a handful of rice into the palm, set a spoon of the cold ragu and peas and a piece of mozzarella in the middle and close the rice over it, into a ball or a cone. Roll each in flour, turn it through the beaten egg and cover it in crumbs. Lay them on a tray and chill them for a short while.",
      "time": null,
      "temperature": null,
      "safety_points": ["cooling-and-keeping"],
      "makes": []
    },
    {
      "technique": "technique/fry-rice-balls",
      "works_on": ["ingredient/arborio-rice"],
      "with": ["ingredient/sunflower-oil"],
      "text": "Heat the oil in a deep, heavy pan until a crumb sizzles at once. Fry a few balls at a time, turning them, until they are deep golden all round. Lift them out onto a rack and let them rest briefly, as the centre will be very hot.",
      "time": {"from": 4, "to": 6, "unit": "minute"},
      "temperature": {"value": 170, "unit": "celsius"},
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/arborio-rice"],
      "with": [],
      "text": "Pile the arancini on a warm plate and serve while the shells are crisp.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
