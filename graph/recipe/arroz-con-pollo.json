{
  "id": "recipe/arroz-con-pollo",
  "tier": "drafted",
  "names": {"en": "Arroz con pollo"},
  "aliases": {},
  "makes": "dish/arroz-con-pollo",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/chicken-thigh", "amount": {"value": 6, "unit": "piece"}, "forms": [], "part": "chicken"},
    {"thing": "ingredient/olive-oil", "amount": {"value": 4, "unit": "tablespoon"}, "forms": [], "part": "oil"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/white-wine", "amount": {"value": 100, "unit": "millilitre"}, "forms": [], "part": "wine"},
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/minced"], "part": "sofrito"},
    {
      "thing": "ingredient/garlic",
      "amount": {"value": 3, "unit": "clove"},
      "forms": ["form/minced"],
      "part": "sofrito"
    },
    {
      "thing": "ingredient/bell-pepper",
      "amount": {"value": 1, "unit": "piece"},
      "forms": ["form/diced"],
      "part": "sofrito"
    },
    {
      "thing": "ingredient/tomato",
      "amount": {"value": 2, "unit": "piece"},
      "forms": ["form/grated"],
      "part": "sofrito"
    },
    {"thing": "ingredient/paprika", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "sofrito"},
    {"thing": "ingredient/rice", "amount": {"value": 320, "unit": "gram"}, "forms": [], "part": "rice"},
    {"thing": "ingredient/chicken-stock", "amount": {"value": 750, "unit": "millilitre"}, "forms": [], "part": "stock"},
    {"thing": "ingredient/saffron", "amount": {"value": 1, "unit": "pinch"}, "forms": [], "part": "saffron"},
    {"thing": "ingredient/peas", "amount": {"value": 100, "unit": "gram"}, "forms": [], "part": "peas"},
    {
      "thing": "ingredient/parsley",
      "amount": {"value": 2, "unit": "sprig"},
      "forms": ["form/chopped"],
      "part": "parsley"
    },
    {"thing": "ingredient/lemon", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/halved"], "part": "lemon"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/dutch-oven", "equipment/saucepan", "equipment/wooden-spoon",
    "equipment/rice-paddle", "equipment/chefs-knife", "equipment/cutting-board", "equipment/grater", "equipment/ladle"
  ],
  "steps": [
    {
      "technique": "technique/season",
      "works_on": ["ingredient/chicken-thigh"],
      "with": ["ingredient/salt"],
      "text": "Season the chicken thighs all over with some of the salt.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sear",
      "works_on": ["ingredient/chicken-thigh"],
      "with": ["ingredient/olive-oil", "ingredient/salt"],
      "text": "Heat some of the oil in a wide, heavy pot over medium-high heat. Brown the thighs skin-side down first, then on the other side, until they are deep golden. Lift them out onto a plate and leave the browned bits in the pot.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/fond"]
    },
    {
      "technique": "technique/deglaze",
      "works_on": ["preparation/fond"],
      "with": ["ingredient/white-wine"],
      "text": "Pour the wine into the hot pot and scrape up the browned bits with a wooden spoon until it has almost gone.",
      "time": {"from": 1, "to": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/infuse",
      "works_on": ["ingredient/chicken-stock"],
      "with": ["ingredient/saffron"],
      "text": "Warm the stock in a saucepan until it steams, drop in the saffron and leave it to turn a deep gold. Keep it hot.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-a-sofrito",
      "works_on": ["ingredient/onion", "ingredient/garlic", "ingredient/tomato"],
      "with": ["ingredient/olive-oil", "ingredient/bell-pepper", "ingredient/paprika"],
      "text": "Add the rest of the oil to the pot. Cook the onion and the pepper over a low heat until soft, then the garlic, then the grated tomato. Go on, stirring now and then, until the water has gone and the paste is dark and jammy. Take the pot off the heat, stir in the paprika and put it back at once.",
      "time": {"from": 12, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/sofrito"]
    },
    {
      "technique": "technique/cook-pilaf",
      "works_on": ["ingredient/rice"],
      "with": ["ingredient/chicken-thigh", "preparation/sofrito", "ingredient/chicken-stock", "ingredient/peas"],
      "text": "Stir the rice into the sofrito until every grain is coated and hot. Tuck the chicken back in, pour in the hot saffron stock, and bring it to a simmer. Scatter the peas on top, cover with a lid and cook over low heat without stirring until the stock has been taken up. Check the thickest part of a thigh against a trusted guide to doneness.",
      "time": {"from": 20, "to": 25, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/rest-and-fluff",
      "works_on": ["ingredient/rice"],
      "with": [],
      "text": "Take the pot off the heat and leave it covered for a short rest, then loosen the rice gently with a paddle.",
      "time": {"from": 5, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/garnish",
      "works_on": ["ingredient/rice"],
      "with": ["ingredient/parsley", "ingredient/lemon"],
      "text": "Scatter over the parsley and serve with the lemon cut in wedges.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
