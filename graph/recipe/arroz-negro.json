  "steps": [
    {
      "technique": "technique/saute",
      "works_on": [],
      "with": ["ingredient/squid", "ingredient/olive-oil"],
      "text": "Heat the oil in the paella pan. Add the squid and stir it over a medium-high heat until the liquid it gives off has gone and it has taken a little colour. Push it to the edge of the pan.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-a-sofrito",
      "works_on": ["ingredient/tomato", "ingredient/garlic"],
      "with": ["ingredient/olive-oil", "ingredient/paprika"],
      "text": "Make a clear space in the middle of the pan. Cook the grated tomato and the garlic there on a low heat, stirring now and then, until the water has gone and the paste is dark and jammy. Take the pan off the heat, stir in the paprika and put it back at once.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/sofrito"]
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/fish-stock"],
      "with": ["ingredient/squid-ink"],
      "text": "Warm the fish stock in a pan until it just simmers, and stir in the squid ink until the stock is evenly black.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/fish-stock"],
      "with": ["ingredient/salt"],
      "text": "Taste the stock and add salt until it tastes a little strong, as the rice will soften it.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-a-paella",
      "works_on": ["ingredient/short-grain-rice"],
      "with": ["ingredient/fish-stock", "preparation/sofrito"],
      "text": "Pour the hot black stock into the pan and bring it to a lively boil. Scatter the rice evenly over the pan and stir once to spread it. Cook it at a strong simmer without stirring, then lower the heat as the rice swells. When the stock has almost gone, turn the heat up for a short while until a faint crackle tells you the bottom is crisping. Take the pan off the heat, cover it with a cloth and let it rest.",
      "time": {"from": 18, "to": 22, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/short-grain-rice"],
      "with": ["preparation/alioli", "ingredient/lemon"],
      "text": "Serve from the pan, with a spoonful of alioli and a wedge of lemon beside each plate.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
