      "works_on": ["ingredient/salt-cod"],
      "with": [],
      "text": "Lift the cod out, divide it in portions and pat it dry.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/dredge",
      "works_on": ["ingredient/salt-cod"],
