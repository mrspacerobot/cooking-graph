    {
      "technique": "technique/pan-fry",
      "works_on": ["ingredient/salt-cod"],
      "with": ["ingredient/olive-oil"],
      "text": "Fry the portions in the oil, skin side down first, and turn them once, until they are lightly golden but not hard.",
