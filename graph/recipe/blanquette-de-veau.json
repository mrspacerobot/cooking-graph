  "steps": [
    {
      "technique": "technique/blanch",
      "works_on": ["ingredient/veal-shoulder"],
      "text": "Cover the veal with cold water, bring it just to a boil, then drain it and rinse off the scum.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": [
        "ingredient/veal-shoulder", "ingredient/water", "ingredient/carrot", "ingredient/onion",
        "preparation/bouquet-garni", "ingredient/salt"
      ],
      "text": "Put the veal back in the clean pot with the measured water, the carrots, the onion, the bouquet garni and the salt. Bring it to a simmer, skim, and cook very gently, lid ajar, until a knife slides into the meat with no resistance. Check the thickest part against a trusted guide to doneness.",
      "time": {"from": 75, "to": 90, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/broth"]
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/pearl-onion", "ingredient/mushroom", "preparation/broth"],
      "text": "Meanwhile cook the pearl onions and the mushrooms in a ladleful of the broth in a small covered pan until tender. They must stay pale.",
      "time": {"from": 12, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-a-roux",
      "works_on": ["ingredient/butter", "ingredient/flour"],
      "text": "Melt the butter in a clean pan, stir in the flour and cook it for a moment without letting it colour.",
      "time": {"value": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/roux"]
    },
    {
      "technique": "technique/whisk",
      "works_on": ["preparation/roux", "preparation/broth"],
      "text": "Strain the broth. Whisk enough of it into the roux, a ladle at a time, to make a sauce that coats a spoon lightly. Simmer it gently.",
      "time": {"value": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/veloute"]
    },
    {
      "technique": "technique/thicken-with-egg-yolk",
      "works_on": ["ingredient/egg-yolk", "ingredient/cream", "preparation/veloute"],
      "text": "Beat the yolks with the cream. Whisk in a ladle of the hot sauce, then stir the mixture back into the pan off the boil. Heat gently until it thickens a little. It must not boil again.",
      "time": null,
      "temperature": null,
      "safety_points": ["raw-or-lightly-cooked-egg"],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/veloute", "ingredient/lemon", "ingredient/salt"],
      "text": "Sharpen the sauce with a few drops of lemon juice, taste it and adjust the salt.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
