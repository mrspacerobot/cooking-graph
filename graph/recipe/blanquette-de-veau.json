{
  "id": "recipe/blanquette-de-veau",
  "tier": "drafted",
  "names": {"en": "Blanquette de veau"},
  "aliases": {},
  "makes": "dish/blanquette-de-veau",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {
      "thing": "ingredient/veal-shoulder",
      "amount": {"value": 1, "unit": "kilogram"},
      "forms": ["form/large-pieces"],
      "part": "veal-shoulder"
    },
    {
      "thing": "ingredient/carrot",
      "amount": {"value": 2, "unit": "piece"},
      "forms": ["form/peeled", "form/large-pieces"],
      "part": "carrot"
    },
    {
      "thing": "ingredient/onion",
      "amount": {"value": 1, "unit": "piece"},
      "forms": ["form/peeled", "form/halved"],
      "part": "onion"
    },
    {
      "thing": "preparation/bouquet-garni",
      "amount": {"value": 1, "unit": "piece"},
      "forms": [],
      "part": "bouquet-garni"
    },
    {"thing": "ingredient/water", "amount": {"value": 1.5, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {
      "thing": "ingredient/mushroom",
      "amount": {"value": 250, "unit": "gram"},
      "forms": ["form/halved"],
      "part": "mushroom"
    },
    {
      "thing": "ingredient/pearl-onion",
      "amount": {"value": 200, "unit": "gram"},
      "forms": ["form/peeled"],
      "part": "pearl-onion"
    },
    {"thing": "ingredient/butter", "amount": {"value": 40, "unit": "gram"}, "forms": [], "part": "roux"},
    {"thing": "ingredient/flour", "amount": {"value": 40, "unit": "gram"}, "forms": [], "part": "roux"},
    {"thing": "ingredient/cream", "amount": {"value": 150, "unit": "millilitre"}, "forms": [], "part": "cream"},
    {"thing": "ingredient/egg-yolk", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "egg-yolk"},
    {"thing": "ingredient/lemon", "amount": {"value": 0.5, "unit": "piece"}, "forms": [], "part": "lemon"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/dutch-oven", "equipment/saucepan", "equipment/fine-sieve", "equipment/whisk",
    "equipment/ladle", "equipment/mixing-bowl"
  ],
  "steps": [
    {
      "technique": "technique/blanch",
      "works_on": ["ingredient/veal-shoulder"],
      "with": [],
      "text": "Cover the veal with cold {water}, bring it just to a boil, then drain it and rinse off the scum.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/veal-shoulder", "ingredient/carrot", "ingredient/onion"],
      "with": ["ingredient/water", "preparation/bouquet-garni", "ingredient/salt"],
      "text": "Put the veal back in the clean pot with the measured {water}, the {carrot:plural}, the {onion}, the {bouquet-garni} and the {salt}. Bring it to a simmer, skim, and cook very gently, lid ajar, until a knife slides into the meat with no resistance. Check the thickest part against a trusted guide to doneness.",
      "time": {"from": 75, "to": 90, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/broth"]
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/pearl-onion", "ingredient/mushroom"],
      "with": ["preparation/broth"],
      "text": "Meanwhile cook the {pearl-onion:plural} and the {mushroom:plural} in a ladleful of the broth in a small covered pan until tender. They must stay pale.",
      "time": {"from": 12, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-a-roux",
      "works_on": ["ingredient/flour"],
      "with": ["ingredient/butter"],
      "text": "Melt the {roux.butter} in a clean pan, stir in the {roux.flour} and cook it for a moment without letting it colour.",
      "time": {"value": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/roux"]
    },
    {
      "technique": "technique/whisk",
      "works_on": ["preparation/roux"],
      "with": ["preparation/broth"],
      "text": "Strain the broth. Whisk enough of it into the roux, a ladle at a time, to make a sauce that coats a spoon lightly. Simmer it gently.",
      "time": {"value": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/veloute"]
    },
    {
      "technique": "technique/thicken-with-egg-yolk",
      "works_on": ["preparation/veloute"],
      "with": ["ingredient/egg-yolk", "ingredient/cream"],
      "text": "Beat the yolks with the {cream}. Whisk in a ladle of the hot sauce, then stir the mixture back into the pan off the boil. Heat gently until it thickens a little. It must not boil again.",
      "time": null,
      "temperature": null,
      "safety_points": ["raw-or-lightly-cooked-egg"],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/veloute"],
      "with": ["ingredient/lemon", "ingredient/salt"],
      "text": "Sharpen the sauce with a few drops of lemon juice, taste it and adjust the {salt}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": [
        "ingredient/veal-shoulder", "ingredient/mushroom", "ingredient/pearl-onion", "ingredient/carrot",
        "preparation/veloute"
      ],
      "with": [],
      "text": "Put the veal, the {mushroom:plural} and the {onion:plural} into the sauce to warm for a moment, and serve with the {carrot:plural}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
