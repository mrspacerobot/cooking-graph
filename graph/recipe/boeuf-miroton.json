      "works_on": ["ingredient/onion"],
      "with": ["ingredient/flour"],
      "text": "Scatter the {flour} over the {onion:plural} and cook it, stirring, until it has turned light brown and smells of toasted nuts.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/deglaze",
      "works_on": ["preparation/fond"],
      "with": ["ingredient/red-wine-vinegar"],
      "text": "Add the vinegar and scrape the pan as it boils away almost to nothing.",
