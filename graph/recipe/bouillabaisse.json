{
  "id": "recipe/bouillabaisse",
  "tier": "drafted",
  "names": {"en": "Bouillabaisse", "fr": "Bouillabaisse"},
  "aliases": {},
  "makes": "dish/bouillabaisse",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {
      "thing": "ingredient/rockfish",
      "amount": {"value": 600, "unit": "gram"},
      "forms": ["form/large-pieces"],
      "part": "broth-fish"
    },
    {
      "thing": "ingredient/monkfish",
      "amount": {"value": 400, "unit": "gram"},
      "forms": ["form/large-pieces"],
      "part": "firm-fish"
    },
    {
      "thing": "ingredient/conger-eel",
      "amount": {"value": 300, "unit": "gram"},
      "forms": ["form/large-pieces"],
      "part": "firm-fish"
    },
    {"thing": "ingredient/red-mullet", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "delicate-fish"},
    {
      "thing": "ingredient/potato",
      "amount": {"value": 500, "unit": "gram"},
      "forms": ["form/sliced"],
      "part": "potato"
    },
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/sliced"], "part": "onion"},
    {"thing": "ingredient/fennel", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/sliced"], "part": "fennel"},
    {"thing": "ingredient/garlic", "amount": {"value": 4, "unit": "clove"}, "forms": [], "part": "garlic"},
    {
      "thing": "ingredient/tomato",
      "amount": {"value": 3, "unit": "piece"},
      "forms": ["form/chopped"],
      "part": "tomato"
    },
    {"thing": "ingredient/saffron", "amount": {"value": 1, "unit": "pinch"}, "forms": [], "part": "saffron"},
    {"thing": "ingredient/orange", "amount": {"value": 0.25, "unit": "piece"}, "forms": [], "part": "orange"},
    {"thing": "ingredient/olive-oil", "amount": {"value": 5, "unit": "tablespoon"}, "forms": [], "part": "olive-oil"},
    {"thing": "ingredient/water", "amount": {"value": 2, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/salt", "amount": {"value": 1.5, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/baguette", "amount": {"value": 8, "unit": "slice"}, "forms": [], "part": "toasts"},
    {"thing": "preparation/rouille", "amount": {"value": 4, "unit": "tablespoon"}, "forms": [], "part": "rouille"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/saucepan", "equipment/fine-sieve", "equipment/ladle",
    "equipment/slotted-spoon", "equipment/grill", "equipment/chefs-knife", "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/fennel", "ingredient/garlic"],
      "with": ["ingredient/olive-oil", "ingredient/salt"],
      "text": "Soften the onion, the fennel and the garlic in the olive oil in the stockpot, without colour, until they are limp and sweet.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/rockfish", "ingredient/tomato"],
      "with": ["ingredient/water", "ingredient/saffron", "ingredient/orange"],
      "text": "Add the rockfish with its head and bones, the tomatoes, the saffron, a strip of the orange peel and the water. Bring to the boil, then keep at a lively simmer and skim off the foam that rises.",
      "time": {"from": 30, "to": 40, "unit": "minute"},
      "temperature": null,
      "safety_points": ["raw-meat-or-fish"],
      "makes": ["preparation/broth"]
    },
    {
      "technique": "technique/strain",
      "works_on": ["preparation/broth"],
      "with": [],
      "text": "Pour the broth through a fine sieve into the saucepan, pressing the solids with the back of a ladle to take every drop. Throw the bones and the pulp away.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/salt"],
      "text": "Return the broth to a simmer, taste it and correct the salt.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/slice",
      "works_on": ["ingredient/potato"],
      "with": [],
      "text": "Peel the potatoes and slice them thick, all to one size.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/potato"],
      "with": ["preparation/broth"],
      "text": "Lay the potato slices in the broth. Keep it at a simmer until a knife slips into a slice with a little resistance.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/monkfish", "ingredient/conger-eel"],
      "with": ["preparation/broth"],
      "text": "Lay the monkfish and the conger eel in the broth, which must cover them, and simmer briskly. They go in first because their flesh is the firmest.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": ["raw-meat-or-fish", "doneness"],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/red-mullet"],
      "with": ["preparation/broth"],
      "text": "Add the red mullet last, because its flesh is the most delicate, and simmer only a short while. Lift the fish out with the slotted spoon as soon as it is firm.",
      "time": {"from": 3, "to": 4, "unit": "minute"},
      "temperature": null,
      "safety_points": ["raw-meat-or-fish", "doneness"],
      "makes": []
    },
    {
      "technique": "technique/toast",
      "works_on": ["ingredient/baguette"],
      "with": [],
      "text": "Toast the slices of baguette under the grill until they are crisp and pale gold on both sides.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": [
        "preparation/broth", "ingredient/monkfish", "ingredient/conger-eel", "ingredient/red-mullet",
        "ingredient/potato", "ingredient/baguette", "preparation/rouille"
      ],
      "with": [],
      "text": "Ladle the broth into warm bowls and serve the fish and the potatoes on a platter beside it. Serve the toasts and the rouille at the table, so that each person spreads a toast with rouille and floats it on the broth.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
