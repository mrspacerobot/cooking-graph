        "ingredient/courgette", "ingredient/aubergine", "ingredient/potato", "ingredient/red-onion",
        "ingredient/green-pepper", "ingredient/tomato"
      ],
      "with": [],
      "text": "Peel the {potato:plural} and slice them thinly, since they take longest. Slice the {courgette:plural} and the {aubergine} into thick rounds, the {onion:plural} into thick half-moons, and the {pepper:plural} into strips. Slice the {tomato:plural} into rounds and keep them apart.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/mince",
      "works_on": ["ingredient/garlic", "ingredient/parsley"],
      "with": [],
      "text": "Mince the {garlic} and chop the {parsley}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/toss",
      "works_on": [
        "ingredient/courgette", "ingredient/aubergine", "ingredient/potato", "ingredient/red-onion",
        "ingredient/green-pepper"
      ],
      "with": [
        "ingredient/olive-oil", "ingredient/garlic", "ingredient/parsley", "ingredient/oregano", "ingredient/salt",
        "ingredient/black-pepper"
      ],
      "text": "In a large bowl, toss the cut vegetables, except the {tomato:plural}, with most of the {oil}, the {garlic}, the {parsley}, the {oregano}, the {salt} and the {black-pepper} until every piece is coated.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/layer",
      "works_on": ["ingredient/courgette", "ingredient/tomato"],
      "with": ["ingredient/water", "ingredient/olive-oil"],
      "text": "Spread the vegetables in a roasting tin, with the {potato:plural} towards the edges where the heat is strongest. Lay the {tomato:plural} over the top, pour the {water} into a corner and drizzle over the rest of the {oil}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/bake",
      "works_on": ["ingredient/courgette", "ingredient/potato"],
      "with": [],
      "text": "Cover the tin with foil and bake until the {potato:plural} are nearly tender.",
      "time": {"from": 40, "to": 45, "unit": "minute"},
      "temperature": {"value": 200, "unit": "celsius"},
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/bake",
      "works_on": ["ingredient/courgette", "ingredient/potato"],
      "with": [],
      "text": "Uncover, stir gently, and bake on until the vegetables are soft and browned at the edges and most of the liquid has turned to oil and juice.",
      "time": {"from": 30, "to": 40, "unit": "minute"},
      "temperature": {"value": 200, "unit": "celsius"},
      "safety_points": [],
      "makes": []
    },
    {
