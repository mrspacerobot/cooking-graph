  ],
  "steps": [
    {
      "technique": "technique/roast",
      "works_on": ["ingredient/veal-bones"],
      "with": [],
      "text": "Spread the {main:plural} in a roasting tin and roast them in a hot oven, turning them once, until deep brown all over.",
      "time": {"from": 40, "to": 45, "unit": "minute"},
      "temperature": {"value": 220, "unit": "celsius"},
      "safety_points": [],
      "makes": ["preparation/fond"]
    },
    {
      "technique": "technique/roast",
      "works_on": ["ingredient/onion", "ingredient/carrot", "ingredient/celery"],
      "with": ["ingredient/tomato-paste"],
      "text": "Add the vegetables, smear the {tomato-paste} over the {main:plural}, and roast until the vegetables have browned at the edges and the paste has darkened.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": {"value": 220, "unit": "celsius"},
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/deglaze",
      "works_on": ["preparation/fond"],
      "with": ["ingredient/water"],
      "text": "Move the {main:plural} and the vegetables to a stockpot. Pour off the fat from the tin, set it over the heat with a ladle of the {water} and scrape up every brown bit. Pour this into the pot.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/skim",
      "works_on": ["preparation/brown-stock"],
      "with": ["ingredient/veal-bones", "ingredient/water"],
      "text": "Add the rest of the cold {water}. Bring it up slowly, and skim off the foam and the fat as they rise.",
      "time": {"from": 20, "to": 30, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["preparation/brown-stock"],
      "with": ["preparation/bouquet-garni", "ingredient/black-pepper"],
      "text": "Add the {bouquet-garni} and the {black-pepper}. Simmer very gently, uncovered, skimming now and then. It must never boil, and it is not salted.",
      "time": {"from": 5, "to": 6, "unit": "hour"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/strain",
      "works_on": ["preparation/brown-stock"],
      "with": [],
      "text": "Ladle the stock through a fine sieve without pressing on the {main:plural}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/chill",
      "works_on": ["preparation/brown-stock"],
      "with": [],
      "text": "Cool it quickly in shallow containers set in iced {water}, then keep it in the fridge. Lift off the fat once it has set on top.",
      "time": null,
      "temperature": null,
      "safety_points": ["cooling-and-keeping"],
      "makes": []
    }
  ]
