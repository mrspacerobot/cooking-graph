{
  "id": "recipe/butter-chicken",
  "tier": "drafted",
  "names": {"en": "Butter chicken"},
  "aliases": {},
  "makes": "dish/butter-chicken",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/chicken-thigh", "amount": {"value": 800, "unit": "gram"}, "forms": [], "part": "chicken"},
    {"thing": "ingredient/plain-yogurt", "amount": {"value": 150, "unit": "gram"}, "forms": [], "part": "yogurt"},
    {
      "thing": "ingredient/kashmiri-red-chilli-powder",
      "amount": {"value": 2, "unit": "teaspoon"},
      "forms": [],
      "part": "paste"
    },
    {"thing": "ingredient/turmeric", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "paste"},
    {"thing": "preparation/garam-masala", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "paste"},
    {"thing": "ingredient/garlic", "amount": {"value": 5, "unit": "clove"}, "forms": ["form/minced"], "part": "paste"},
    {"thing": "ingredient/ginger", "amount": {"value": 20, "unit": "gram"}, "forms": ["form/grated"], "part": "paste"},
    {
      "thing": "ingredient/green-chilli",
      "amount": {"value": 1, "unit": "piece"},
      "forms": ["form/sliced"],
      "part": "paste"
    },
    {"thing": "ingredient/lemon-juice", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "paste"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/oil", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "roasting-oil"},
    {
      "thing": "ingredient/tomato",
      "amount": {"value": 600, "unit": "gram"},
      "forms": ["form/chopped"],
      "part": "tomato"
    },
    {"thing": "ingredient/butter", "amount": {"value": 50, "unit": "gram"}, "forms": [], "part": "butter"},
    {"thing": "ingredient/water", "amount": {"value": 150, "unit": "millilitre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/cream", "amount": {"value": 150, "unit": "millilitre"}, "forms": [], "part": "cream"},
    {"thing": "ingredient/sugar", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "sugar"},
    {
      "thing": "ingredient/dried-fenugreek-leaf",
      "amount": {"value": 1, "unit": "tablespoon"},
      "forms": [],
      "part": "fenugreek"
    },
    {
      "thing": "ingredient/coriander-leaf",
      "amount": {"value": 10, "unit": "gram"},
      "forms": ["form/chopped"],
      "part": "coriander"
    }
  ],
  "equipment": [
    "equipment/stovetop", "equipment/oven", "equipment/blender", "equipment/mixing-bowl", "equipment/roasting-tin",
    "equipment/saute-pan", "equipment/wooden-spoon"
  ],
  "steps": [
    {
      "technique": "technique/make-spice-paste",
      "works_on": [
        "ingredient/garlic", "ingredient/ginger", "ingredient/green-chilli", "ingredient/kashmiri-red-chilli-powder"
      ],
      "with": ["ingredient/turmeric", "preparation/garam-masala", "ingredient/lemon-juice", "ingredient/salt"],
      "text": "Blend the {paste.garlic}, {paste.ginger} and {paste.green-chilli} with the chilli powder, the {paste.turmeric}, the {paste.garam-masala}, the {paste.lemon-juice} and half of the {salt} to a thick paste.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/spice-paste"]
    },
    {
      "technique": "technique/marinate-in-yogurt",
      "works_on": ["ingredient/chicken-thigh"],
      "with": ["ingredient/plain-yogurt", "preparation/spice-paste"],
      "text": "Whisk half of the paste into the {yogurt}. Cut a few shallow slashes into the chicken, turn it in the marinade until it is coated all over, and cover the bowl. Keep it in the fridge and keep the rest of the paste for the sauce.",
      "time": {"from": 2, "to": 8, "unit": "hour"},
      "temperature": null,
      "safety_points": ["cooling-and-keeping"],
      "makes": []
    },
    {
      "technique": "technique/roast",
      "works_on": ["ingredient/chicken-thigh"],
      "with": ["ingredient/oil"],
      "text": "Lift the chicken out and let the extra marinade drip off. Lay the pieces in a roasting tin, brush them with the {roasting-oil} and roast in a very hot oven until the edges are charred in places. Check the thickest piece against a trusted guide to doneness.",
      "time": {"from": 20, "to": 30, "unit": "minute"},
      "temperature": {"value": 230, "unit": "celsius"},
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/fry-masala-base",
      "works_on": ["ingredient/tomato", "preparation/spice-paste"],
      "with": ["ingredient/butter", "ingredient/water", "ingredient/salt"],
      "text": "Melt the {butter} in a wide pan. Stir in the rest of the paste for a moment, add the chopped {tomato} and the {water}, and cook down, mashing the {tomato} with the spoon, until it has collapsed into a thick sauce and the {butter} shines at the edge.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/puree",
      "works_on": ["ingredient/tomato"],
      "with": [],
      "text": "Blend the sauce until it is smooth and return it to the pan.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-in-masala-gravy",
      "works_on": ["ingredient/chicken-thigh"],
      "with": ["ingredient/cream", "ingredient/sugar", "ingredient/dried-fenugreek-leaf"],
      "text": "Add the roasted chicken and any juices from the tin to the sauce and simmer gently, uncovered, so that the sauce clings to the pieces. Stir in the {cream}, the {sugar} and the {fenugreek} crushed between the palms.",
      "time": {"from": 8, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/chicken-thigh"],
      "with": ["ingredient/salt", "ingredient/sugar"],
      "text": "Taste the gravy and adjust the {salt} and the {sugar} until the sharpness of the {tomato} is softened and the gravy is mild, rich and tangy.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/garnish",
      "works_on": ["ingredient/chicken-thigh"],
      "with": ["ingredient/coriander-leaf"],
      "text": "Scatter the {coriander} over the chicken and serve it hot.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
