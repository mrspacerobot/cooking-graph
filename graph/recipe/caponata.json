{
  "id": "recipe/caponata",
  "tier": "drafted",
  "names": {"en": "Caponata", "fr": "Caponata"},
  "aliases": {},
  "makes": "dish/caponata",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {
      "thing": "ingredient/aubergine",
      "amount": {"value": 600, "unit": "gram"},
      "forms": ["form/diced"],
      "part": "aubergine"
    },
    {"thing": "ingredient/salt", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/olive-oil", "amount": {"value": 100, "unit": "millilitre"}, "forms": [], "part": "oil"},
    {"thing": "ingredient/celery", "amount": {"value": 3, "unit": "piece"}, "forms": ["form/sliced"], "part": "celery"},
    {
      "thing": "ingredient/onion",
      "amount": {"value": 1, "unit": "piece"},
      "forms": ["form/peeled", "form/sliced"],
      "part": "onion"
    },
    {
      "thing": "ingredient/tomato",
      "amount": {"value": 300, "unit": "gram"},
      "forms": ["form/chopped"],
      "part": "tomato"
    },
    {"thing": "ingredient/green-olive", "amount": {"value": 80, "unit": "gram"}, "forms": [], "part": "olive"},
    {"thing": "ingredient/capers", "amount": {"value": 2, "unit": "tablespoon"}, "forms": [], "part": "caper"},
    {"thing": "ingredient/vinegar", "amount": {"value": 60, "unit": "millilitre"}, "forms": [], "part": "agrodolce"},
    {"thing": "ingredient/sugar", "amount": {"value": 2, "unit": "tablespoon"}, "forms": [], "part": "agrodolce"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/frying-pan", "equipment/saucepan", "equipment/colander", "equipment/slotted-spoon",
    "equipment/wooden-spoon", "equipment/chefs-knife", "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/salt-and-drain",
      "works_on": ["ingredient/aubergine"],
      "with": ["ingredient/salt"],
      "text": "Toss the diced aubergine with the salt and leave it in a colander until it has given up its water. Pat the pieces dry.",
      "time": {"from": 30, "to": 60, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/saute",
      "works_on": ["ingredient/aubergine"],
      "with": ["ingredient/olive-oil"],
      "text": "Fry the aubergine in the olive oil in a wide pan, in small lots, until it is deep gold and creamy inside. Lift each lot out with a slotted spoon and drain it.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/celery"],
      "with": ["ingredient/olive-oil"],
      "text": "In the same pan, with a little of the oil left in it, soften the onion and the celery over medium heat until they are tender but still have a little bite.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/tomato"],
      "with": ["ingredient/green-olive", "ingredient/capers"],
      "text": "Add the tomatoes, the olives and the capers, and let them simmer gently until the tomatoes have broken down into a thick sauce.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-agrodolce",
      "works_on": ["ingredient/vinegar", "ingredient/sugar"],
      "with": [],
      "text": "Warm the vinegar with the sugar in a small pan and stir until the sugar has dissolved, then let it bubble gently until it smells mellow and not sharp.",
      "time": {"from": 3, "to": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/agrodolce"]
    },
    {
      "technique": "technique/toss",
      "works_on": ["ingredient/aubergine"],
      "with": [
        "preparation/agrodolce", "ingredient/onion", "ingredient/celery", "ingredient/tomato", "ingredient/green-olive",
        "ingredient/capers"
      ],
      "text": "Return the aubergine to the pan with the sauce, pour in the sweet-sour syrup and turn everything over low heat until it is glazed. Taste, and add sugar if it bites or vinegar if it cloys.",
      "time": {"from": 3, "to": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/aubergine"],
      "with": [],
      "text": "Take the pan off the heat and let the caponata cool and stand, so that the flavours settle. It is better after a night in a cool place. Serve it at room temperature.",
      "time": {"from": 1, "to": 24, "unit": "hour"},
      "temperature": null,
      "safety_points": ["cooling-and-keeping"],
      "makes": []
    }
  ]
}
