{
  "id": "recipe/carnitas",
  "tier": "drafted",
  "names": {"en": "Carnitas"},
  "aliases": {},
  "makes": "dish/carnitas",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/pork-shoulder", "amount": {"value": 1.5, "unit": "kilogram"}, "forms": [], "part": "pork"},
    {"thing": "ingredient/lard", "amount": {"value": 2, "unit": "tablespoon"}, "forms": [], "part": "lard"},
    {"thing": "ingredient/orange", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "orange"},
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/halved"], "part": "onion"},
    {"thing": "ingredient/garlic", "amount": {"value": 4, "unit": "clove"}, "forms": ["form/peeled"], "part": "garlic"},
