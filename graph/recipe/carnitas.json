    {"thing": "ingredient/oregano", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "oregano"},
    {"thing": "ingredient/bay-leaf", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "bay-leaf"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/water", "amount": {"value": 500, "unit": "millilitre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/corn-tortilla", "amount": {"value": 12, "unit": "piece"}, "forms": [], "part": "tortillas"},
    {"thing": "ingredient/onion", "amount": {"value": 0.5, "unit": "piece"}, "forms": [], "part": "serving-onion"},
    {"thing": "ingredient/coriander-leaf", "amount": {"value": 6, "unit": "sprig"}, "forms": [], "part": "coriander"},
    {"thing": "ingredient/lime", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "lime"},
    {"thing": "ingredient/tomato-salsa", "amount": {"value": 150, "unit": "gram"}, "forms": [], "part": "salsa"}
