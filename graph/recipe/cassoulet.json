{
  "id": "recipe/cassoulet",
  "tier": "drafted",
  "names": {"en": "Cassoulet", "fr": "Cassoulet"},
  "aliases": {},
  "makes": "dish/cassoulet",
  "yields": {"value": 6, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/white-beans", "amount": {"value": 500, "unit": "gram"}, "forms": [], "part": "beans"},
    {"thing": "ingredient/water", "amount": {"value": 2.5, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/onion", "amount": {"value": 2, "unit": "piece"}, "forms": ["form/peeled"], "part": "onion"},
    {"thing": "ingredient/clove", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "clove"},
    {"thing": "preparation/bouquet-garni", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "herbs"},
    {
      "thing": "ingredient/pork-shoulder",
      "amount": {"value": 600, "unit": "gram"},
      "forms": ["form/large-pieces"],
      "part": "pork"
    },
    {"thing": "ingredient/duck-fat", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "duck-fat"},
    {"thing": "ingredient/garlic", "amount": {"value": 4, "unit": "clove"}, "forms": ["form/peeled"], "part": "garlic"},
    {
      "thing": "ingredient/tomato-paste",
      "amount": {"value": 2, "unit": "tablespoon"},
      "forms": [],
      "part": "tomato-paste"
    },
    {"thing": "ingredient/white-wine", "amount": {"value": 200, "unit": "millilitre"}, "forms": [], "part": "wine"},
    {"thing": "ingredient/stock", "amount": {"value": 500, "unit": "millilitre"}, "forms": [], "part": "stock"},
    {"thing": "ingredient/pork-sausage", "amount": {"value": 500, "unit": "gram"}, "forms": [], "part": "sausage"},
    {"thing": "ingredient/duck-confit", "amount": {"value": 4, "unit": "piece"}, "forms": [], "part": "confit"},
    {"thing": "preparation/breadcrumbs", "amount": {"value": 100, "unit": "gram"}, "forms": [], "part": "crumbs"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/oven", "equipment/mixing-bowl", "equipment/colander", "equipment/stockpot",
    "equipment/dutch-oven", "equipment/saute-pan", "equipment/frying-pan", "equipment/earthenware-jar",
    "equipment/tongs", "equipment/ladle", "equipment/spoon", "equipment/paring-knife", "equipment/chefs-knife",
    "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/soak",
      "works_on": ["ingredient/white-beans"],
      "with": ["ingredient/water"],
      "text": "Cover the beans generously with cold water and leave them overnight. Drain and rinse them.",
      "time": {"from": 8, "to": 12, "unit": "hour"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/white-beans"],
      "with": [
        "ingredient/water", "ingredient/onion", "ingredient/clove", "preparation/bouquet-garni", "ingredient/salt"
      ],
      "text": "Put the beans in a large pot with fresh water, one onion stuck with the cloves and the bundle of herbs. Bring to a boil, then simmer gently, without salt, until the beans are tender but still hold their shape. Add the salt near the end. Keep the cooking water.",
      "time": {"from": 60, "to": 90, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/trim",
      "works_on": ["ingredient/pork-shoulder"],
      "with": [],
      "text": "Cut off the hard skin and surplus gristle from the pork and cut the meat into large pieces.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sear",
      "works_on": ["ingredient/pork-shoulder"],
      "with": ["ingredient/duck-fat", "ingredient/salt"],
      "text": "Brown the pork in the duck fat in a heavy pot over a high heat, in batches, until each piece has a deep brown crust. Lift the pork out.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/fond"]
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/garlic"],
      "with": [],
      "text": "Soften the second onion, chopped, and the garlic in the same pot until sweet, without letting them darken.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/deglaze",
      "works_on": ["preparation/fond"],
      "with": ["ingredient/tomato-paste", "ingredient/white-wine"],
      "text": "Stir in the tomato paste, then pour in the wine and scrape up everything stuck to the base as it boils.",
      "time": {"value": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/pan-sauce"]
    },
    {
      "technique": "technique/braise",
      "works_on": ["ingredient/pork-shoulder"],
      "with": ["ingredient/stock", "preparation/pan-sauce"],
      "text": "Return the pork to the pot with the stock. Cover and braise in a low oven until the pork is very tender and the liquid has reduced to a rich sauce.",
      "time": {"from": 90, "to": 120, "unit": "minute"},
      "temperature": {"value": 160, "unit": "celsius"},
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/prick",
      "works_on": ["ingredient/pork-sausage"],
      "with": [],
      "text": "Prick the sausages in a few places.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/pan-fry",
      "works_on": ["ingredient/pork-sausage"],
      "with": [],
      "text": "Brown the sausages in a frying pan, turning them, until they take colour all over. Cut them into thick pieces.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/layer",
      "works_on": [
        "ingredient/white-beans", "ingredient/pork-shoulder", "ingredient/pork-sausage", "ingredient/duck-confit"
      ],
      "with": [],
      "text": "Spread half of the drained beans over the base of a deep earthenware pot. Lay the pork, the sausage and the confit on top and cover with the rest of the beans. Pour over the pork sauce and enough bean cooking water to come just below the top of the beans.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/break-the-crust",
      "works_on": ["ingredient/white-beans", "preparation/breadcrumbs"],
      "with": ["preparation/breadcrumbs"],
      "text": "Sprinkle a thick layer of crumbs over the top and bake in a low oven until a golden crust forms. Press the crust down into the pot with the back of a spoon and bake until a new one forms. Do this several times, adding a ladle of hot bean water if the pot looks dry, and leave the last crust whole.",
      "time": {"from": 120, "to": 180, "unit": "minute"},
      "temperature": {"value": 160, "unit": "celsius"},
      "safety_points": ["doneness"],
      "makes": []
    }
  ]
}
