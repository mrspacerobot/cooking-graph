    {
      "technique": "technique/make-atta-dough",
      "works_on": ["ingredient/whole-wheat-flour"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Put the flour and the salt in a bowl and work in the warm water a little at a time, until the dough is soft and smooth and no longer sticks. Cover it with a damp cloth and leave it to rest, then tear off equal balls and roll them smooth between the palms.",
      "time": {"from": 30, "to": 45, "unit": "minute"},
