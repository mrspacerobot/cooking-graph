      "safety_points": [],
      "makes": ["preparation/chapati-dough"]
    },
    {
      "technique": "technique/roll-out-a-chapati",
      "works_on": ["preparation/chapati-dough"],
      "with": ["ingredient/whole-wheat-flour"],
      "text": "Flatten a ball in the dry flour and roll it from the centre outwards, turning it after each stroke, into a thin, even round. Shake off the extra flour.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-a-chapati",
      "works_on": ["preparation/chapati-dough"],
      "with": ["ingredient/ghee"],
      "text": "Lay the round on a hot iron plate. When bubbles show, turn it and cook the second face until it is spotted with brown. Lift it with tongs and hold it on the open flame until it swells into a ball, then brush it with ghee and stack it in a cloth.",
      "time": {"from": 1, "to": 2, "unit": "minute"},
