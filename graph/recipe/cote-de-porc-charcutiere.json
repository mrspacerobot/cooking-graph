      "amount": {"value": 100, "unit": "millilitre"},
      "forms": [],
      "part": "white-wine"
    },
    {"thing": "ingredient/beef-stock", "amount": {"value": 150, "unit": "millilitre"}, "forms": [], "part": "stock"},
    {
      "thing": "ingredient/dijon-mustard",
