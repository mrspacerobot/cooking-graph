  "steps": [
    {
      "technique": "technique/sear",
      "works_on": ["ingredient/pork-chop"],
      "with": ["ingredient/salt", "ingredient/sunflower-oil"],
      "text": "Dry the chops and {salt} them. Sear them in the {sunflower-oil} in a hot, heavy pan until deep golden on both sides, then lower the heat and cook them more gently. Check the thickest part against a trusted guide to doneness.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/fond"]
    },
    {
      "technique": "technique/rest",
      "works_on": ["ingredient/pork-chop"],
      "with": [],
      "text": "Rest the chops on a warm plate, loosely covered.",
      "time": {"value": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion"],
      "with": ["ingredient/butter"],
      "text": "Pour off the fat. Soften the {onion} in the {butter} in the same pan over low heat.",
      "time": {"from": 3, "to": 4, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/deglaze",
      "works_on": ["preparation/fond"],
      "with": ["ingredient/white-wine"],
      "text": "Pour in the {white-wine} and scrape the pan clean. Boil until almost all of it has gone.",
      "time": {"value": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/pan-sauce"]
    },
    {
      "technique": "technique/reduce",
      "works_on": ["preparation/pan-sauce", "ingredient/beef-stock"],
      "with": [],
      "text": "Add the {stock} and boil it down until the sauce coats a spoon.",
      "time": {"from": 4, "to": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/pan-sauce"],
      "with": ["ingredient/dijon-mustard", "ingredient/cornichons", "ingredient/black-pepper"],
      "text": "Take the pan off the heat. Stir in the {dijon-mustard}, which must not boil, then the {cornichons}, the {black-pepper} and the juices from the resting chops. Taste.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/pork-chop", "preparation/pan-sauce"],
      "with": [],
      "text": "Serve the chops on warm plates with the sauce spooned beside them.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
