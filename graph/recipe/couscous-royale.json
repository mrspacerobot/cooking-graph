{
  "id": "recipe/couscous-royale",
  "tier": "drafted",
  "names": {"en": "Couscous royale"},
  "aliases": {},
  "makes": "dish/couscous-royale",
  "yields": {"value": 6, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/couscous", "amount": {"value": 500, "unit": "gram"}, "forms": [], "part": "couscous"},
    {
      "thing": "ingredient/lamb-shoulder",
      "amount": {"value": 700, "unit": "gram"},
      "forms": ["form/large-pieces"],
      "part": "lamb"
    },
    {"thing": "ingredient/chicken-thigh", "amount": {"value": 800, "unit": "gram"}, "forms": [], "part": "chicken"},
    {"thing": "ingredient/merguez", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "merguez"},
    {"thing": "ingredient/chickpea", "amount": {"value": 150, "unit": "gram"}, "forms": [], "part": "chickpea"},
    {"thing": "ingredient/onion", "amount": {"value": 2, "unit": "piece"}, "forms": ["form/sliced"], "part": "onion"},
    {
      "thing": "ingredient/tomato",
      "amount": {"value": 3, "unit": "piece"},
      "forms": ["form/chopped"],
      "part": "tomato"
    },
    {"thing": "ingredient/carrot", "amount": {"value": 3, "unit": "piece"}, "forms": ["form/peeled"], "part": "carrot"},
    {"thing": "ingredient/turnip", "amount": {"value": 2, "unit": "piece"}, "forms": ["form/peeled"], "part": "turnip"},
    {"thing": "ingredient/courgette", "amount": {"value": 3, "unit": "piece"}, "forms": [], "part": "courgette"},
    {"thing": "ingredient/pumpkin", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "pumpkin"},
    {"thing": "ingredient/smen", "amount": {"value": 60, "unit": "gram"}, "forms": [], "part": "fat"},
    {"thing": "ingredient/olive-oil", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "olive-oil"},
    {
      "thing": "preparation/ras-el-hanout",
      "amount": {"value": 1, "unit": "teaspoon"},
      "forms": [],
      "part": "ras-el-hanout"
    },
    {"thing": "ingredient/ginger", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "ginger"},
    {"thing": "ingredient/turmeric", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "turmeric"},
    {"thing": "ingredient/black-pepper", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "pepper"},
    {"thing": "ingredient/saffron", "amount": {"value": 1, "unit": "pinch"}, "forms": [], "part": "saffron"},
    {"thing": "ingredient/water", "amount": {"value": 3.5, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/coriander-leaf", "amount": {"value": 8, "unit": "sprig"}, "forms": [], "part": "coriander"},
    {"thing": "ingredient/parsley", "amount": {"value": 8, "unit": "sprig"}, "forms": [], "part": "parsley"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/couscoussier", "equipment/saucepan", "equipment/mixing-bowl",
    "equipment/wooden-spoon", "equipment/ladle", "equipment/chefs-knife", "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/soak",
      "works_on": ["ingredient/chickpea"],
      "with": ["ingredient/water"],
      "text": "Cover the dried {chickpea} with cold {water} and leave them to soak overnight. Drain them.",
      "time": {"from": 8, "to": 12, "unit": "hour"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion"],
      "with": ["ingredient/smen"],
      "text": "Melt half of the {fat} in the base of the couscoussier and soften the {onion} over a low heat until they are glossy and soft.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/lamb-shoulder", "ingredient/chickpea", "ingredient/tomato"],
      "with": [
        "ingredient/water", "ingredient/ginger", "ingredient/turmeric", "ingredient/black-pepper",
        "preparation/ras-el-hanout", "ingredient/saffron"
      ],
      "text": "Add the lamb, the {chickpea} and the {tomato} with the {ginger}, the {turmeric}, the {pepper}, the {ras-el-hanout} [saffron: and the {saffron}], and pour in the {water}. Bring to a boil, skim, then lower the heat and simmer until the lamb is nearly tender. Check a piece against a trusted guide to doneness.",
      "time": {"from": 45, "to": 60, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/broth"]
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/chicken-thigh", "ingredient/carrot", "ingredient/turnip"],
      "with": ["preparation/broth"],
      "text": "Add the chicken, the {carrot} and the {turnip} to the broth and simmer on, so that the chicken and the roots turn tender together. Check a piece of chicken against a trusted guide to doneness.",
      "time": {"from": 30, "to": 40, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/pumpkin", "ingredient/courgette"],
      "with": ["preparation/broth"],
      "text": "Add the {pumpkin} and the {courgette} last and simmer until a knife slips into the {pumpkin}.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/steam-couscous",
      "works_on": ["ingredient/couscous"],
      "with": ["ingredient/water", "ingredient/olive-oil", "ingredient/smen", "ingredient/salt"],
      "text": "While the stew simmers, sprinkle the {couscous} with salted {water} and rub it with {olive-oil}, steam it in the top of the couscoussier over the stew, tip it out, sprinkle it again, rake it apart and steam it once more. Rake in the rest of the {fat} until the grains shine.",
      "time": {"from": 30, "to": 40, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/merguez"],
      "with": ["preparation/broth"],
      "text": "In a separate pan, warm the {merguez} in a ladle of the broth just until it is firm and has given up its red fat, then lift it out. Cooking it apart keeps the broth clear. Check a piece against a trusted guide to doneness.",
      "time": {"from": 8, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/chop",
      "works_on": ["ingredient/coriander-leaf", "ingredient/parsley"],
      "with": [],
      "text": "Chop the {coriander} and the {parsley}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/salt"],
      "text": "Taste the broth and adjust the {salt}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": [
        "ingredient/couscous", "ingredient/lamb-shoulder", "ingredient/chicken-thigh", "ingredient/merguez",
        "preparation/broth"
      ],
      "with": ["ingredient/coriander-leaf", "ingredient/parsley"],
      "text": "Heap the {couscous} on a wide dish and make a hollow in the middle. Set the lamb, the chicken, the {merguez}, the {chickpea} and the vegetables in it, ladle over some of the broth and scatter with the herbs. Serve the rest of the broth alongside.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
