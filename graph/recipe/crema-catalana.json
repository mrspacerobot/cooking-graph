{
  "id": "recipe/crema-catalana",
  "tier": "drafted",
  "names": {"en": "Crema catalana"},
  "aliases": {},
  "makes": "dish/crema-catalana",
  "yields": {"value": 6, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/milk", "amount": {"value": 500, "unit": "millilitre"}, "forms": [], "part": "milk"},
    {"thing": "ingredient/lemon-zest", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "lemon"},
    {"thing": "ingredient/cinnamon", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "cinnamon"},
    {"thing": "ingredient/egg-yolk", "amount": {"value": 5, "unit": "piece"}, "forms": [], "part": "yolks"},
    {"thing": "ingredient/sugar", "amount": {"value": 100, "unit": "gram"}, "forms": [], "part": "sugar"},
    {"thing": "ingredient/cornstarch", "amount": {"value": 2, "unit": "tablespoon"}, "forms": [], "part": "starch"},
    {"thing": "ingredient/sugar", "amount": {"value": 40, "unit": "gram"}, "forms": [], "part": "topping"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/saucepan", "equipment/mixing-bowl", "equipment/whisk", "equipment/wooden-spoon",
    "equipment/fine-sieve", "equipment/ramekin", "equipment/grill"
  ],
  "steps": [
    {
      "technique": "technique/infuse",
      "works_on": ["ingredient/milk"],
      "with": ["ingredient/lemon-zest", "ingredient/cinnamon"],
      "text": "Warm the {milk} in a saucepan with the strips of lemon peel and the {cinnamon} stick until it steams, but do not let it boil. Take it off the heat, cover it and leave it to take on the scent, then lift out the peel and the {cinnamon}.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/whisk",
      "works_on": ["ingredient/egg-yolk"],
      "with": ["ingredient/sugar", "ingredient/cornstarch"],
      "text": "Whisk the yolks with the {sugar} and the {starch} in a bowl until pale and smooth, with no lumps of starch.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-a-custard",
      "works_on": ["ingredient/egg-yolk"],
      "with": ["ingredient/milk"],
      "text": "Bring the scented {milk} back to a steam. Pour a little onto the yolk mixture, whisking all the time, then pour the rest in and return everything to the pan. Stir over low heat, scraping the bottom, until the custard thickens and coats the back of the spoon, letting it bubble just once to cook the starch. Pass it through a fine sieve.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": ["raw-or-lightly-cooked-egg"],
      "makes": []
    },
    {
      "technique": "technique/set",
      "works_on": ["ingredient/cornstarch"],
      "with": [],
      "text": "Pour the custard into shallow dishes. Let it cool, then cover and chill it until it is cold and firm. Keep it chilled until the moment of burning the top.",
      "time": {"from": 4, "to": 6, "unit": "hour"},
      "temperature": null,
      "safety_points": ["cooling-and-keeping"],
      "makes": []
    },
    {
      "technique": "technique/burn-a-sugar-crust",
      "works_on": ["ingredient/sugar"],
      "with": [],
      "text": "Just before serving, scatter a thin, even layer of {topping} over each custard and melt it with a kitchen torch or under a very hot grill, keeping the flame moving, until it is deep amber. Leave it a moment to harden.",
      "time": {"from": 1, "to": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
