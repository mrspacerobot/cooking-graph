    {
      "technique": "technique/roll",
      "works_on": ["ingredient/vine-leaf"],
      "with": ["ingredient/rice"],
      "text": "Rinse the leaves well to wash off the brine, and soften them in hot {water}. Lay each leaf flat with the shiny side down, put a spoonful of filling near the stalk end, fold in the sides and roll up firmly but not tight, so that the {rice} has room to swell.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
