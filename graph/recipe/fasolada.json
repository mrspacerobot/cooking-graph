    {"thing": "ingredient/parsley", "amount": {"value": 20, "unit": "gram"}, "forms": [], "part": "parsley"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/black-pepper", "amount": {"value": 1, "unit": "pinch"}, "forms": [], "part": "pepper"}
