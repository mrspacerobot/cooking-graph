  "equipment": [
    "equipment/stovetop", "equipment/dutch-oven", "equipment/mixing-bowl", "equipment/colander",
    "equipment/chefs-knife", "equipment/cutting-board", "equipment/wooden-spoon", "equipment/ladle"
  ],
  "steps": [
    {
      "technique": "technique/soak",
      "works_on": ["ingredient/white-beans"],
      "with": ["ingredient/water"],
      "text": "Cover the {beans} generously with cold {water} and leave them overnight, until they are plump.",
      "time": {"from": 8, "to": 12, "unit": "hour"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/drain",
      "works_on": ["ingredient/white-beans"],
      "with": [],
      "text": "Drain the {beans} and rinse them.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/carrot", "ingredient/celery"],
      "with": ["ingredient/olive-oil"],
      "text": "Dice the {onion}, the {carrot} and the {celery}. Soften them in some of the {oil} in a large pot until they are soft and glassy, without letting them colour.",
