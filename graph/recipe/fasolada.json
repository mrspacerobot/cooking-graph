      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/white-beans"],
      "with": ["ingredient/water", "ingredient/bay-leaf"],
      "text": "Add the {beans}, the {bay} and fresh {water}. Bring to a boil, then turn the heat low and simmer gently, with the lid ajar, until the {beans} are nearly tender. Keep the {beans} covered with {water}. Do not {salt} yet.",
      "time": {"from": 45, "to": 60, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/white-beans"],
      "with": ["ingredient/tomato-paste"],
      "text": "Stir in the {tomato} and simmer on until the {beans} are completely tender and the broth has thickened to a creamy soup.",
      "time": {"from": 20, "to": 30, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/chop",
      "works_on": ["ingredient/parsley"],
      "with": [],
      "text": "Chop the {parsley}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/white-beans"],
      "with": ["ingredient/salt", "ingredient/black-pepper"],
      "text": "Season with the {salt} and the {pepper}, and taste. Take out the {bay}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/garnish",
      "works_on": ["ingredient/white-beans"],
      "with": ["ingredient/olive-oil", "ingredient/parsley"],
      "text": "Ladle the soup into bowls. Pour a thread of raw {oil} into each and scatter with {parsley}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
