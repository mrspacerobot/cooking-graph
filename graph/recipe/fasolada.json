{
  "id": "recipe/fasolada",
  "tier": "drafted",
  "names": {"en": "Fasolada"},
  "aliases": {},
  "makes": "dish/fasolada",
  "yields": {"value": 6, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/white-beans", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "beans"},
    {"thing": "ingredient/water", "amount": {"value": 1.5, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/water", "amount": {"value": 2, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/onion", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "onion"},
    {"thing": "ingredient/carrot", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "carrot"},
    {"thing": "ingredient/celery", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "celery"},
    {"thing": "ingredient/olive-oil", "amount": {"value": 150, "unit": "millilitre"}, "forms": [], "part": "oil"},
    {"thing": "ingredient/bay-leaf", "amount": {"value": 2, "unit": "leaf"}, "forms": [], "part": "bay"},
