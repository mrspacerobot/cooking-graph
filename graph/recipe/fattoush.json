{
  "id": "recipe/fattoush",
  "tier": "drafted",
  "names": {"en": "Fattoush"},
  "aliases": {},
  "makes": "dish/fattoush",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
