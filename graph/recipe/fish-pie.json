{
  "id": "recipe/fish-pie",
  "tier": "drafted",
  "names": {"en": "Fish pie"},
  "aliases": {},
  "makes": "dish/fish-pie",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {
