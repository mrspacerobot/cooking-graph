{
  "id": "recipe/french-onion-soup",
  "tier": "drafted",
  "names": {"en": "French onion soup"},
  "aliases": {},
  "makes": "dish/french-onion-soup",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
