    {"thing": "ingredient/semolina", "amount": {"value": 150, "unit": "gram"}, "forms": [], "part": "custard"},
    {"thing": "ingredient/sugar", "amount": {"value": 200, "unit": "gram"}, "forms": [], "part": "custard"},
    {"thing": "ingredient/egg", "amount": {"value": 4, "unit": "piece"}, "forms": [], "part": "custard"},
    {"thing": "ingredient/vanilla", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "custard"},
    {"thing": "ingredient/butter", "amount": {"value": 250, "unit": "gram"}, "forms": [], "part": "butter"},
    {"thing": "ingredient/phyllo", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "phyllo"},
