      "technique": "technique/layer",
      "works_on": ["ingredient/potato-gnocchi"],
      "with": ["ingredient/mozzarella", "ingredient/parmesan", "ingredient/basil"],
      "text": "Spoon half of the {gnocchi} and their sauce into a baking dish and scatter with half of the {mozzarella} and the rest of the {basil}, torn. Add the rest of the {gnocchi} and top with the remaining {mozzarella} and the {cheese}.",
