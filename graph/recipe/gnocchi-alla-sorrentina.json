      "with": ["ingredient/mozzarella", "ingredient/parmesan"],
      "text": "Bake in a hot oven until the {mozzarella} has melted and bubbles, golden in spots.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": {"value": 200, "unit": "celsius"},
