      "text": "Bring a large pot of {water} to the boil and season it with the {salt}. Drop in the {gnocchi} and lift them out with a slotted spoon as soon as they float.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/toss",
      "works_on": ["ingredient/potato-gnocchi"],
