      "technique": "technique/make-a-roux",
      "works_on": ["ingredient/flour"],
      "with": ["ingredient/butter"],
      "text": "Melt most of the {butter} in a saucepan, stir in the {bechamel.flour} and cook it, stirring, until it froths and smells of biscuit. It must stay pale.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/roux"]
    },
    {
      "technique": "technique/whisk",
      "works_on": ["preparation/roux"],
      "with": ["ingredient/milk"],
      "text": "Off the heat, whisk in the cold {bechamel.milk} a little at a time, and make each addition smooth before the next.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/bechamel"]
    },
    {
      "technique": "technique/simmer",
      "works_on": ["preparation/bechamel"],
      "with": ["ingredient/nutmeg", "ingredient/gruyere", "ingredient/salt"],
      "text": "Simmer the sauce, stirring, until it coats a spoon. Off the heat, stir in the {bechamel.nutmeg} and half the cheese, and taste for {salt}.",
