      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/gratinate",
      "works_on": ["ingredient/gruyere"],
      "with": [],
      "text": "Bake in a hot oven until the sauce bubbles at the edges and the top is golden brown.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": {"value": 200, "unit": "celsius"},
      "safety_points": [],
      "makes": []
