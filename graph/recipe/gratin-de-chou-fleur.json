      "works_on": ["ingredient/cauliflower"],
      "with": ["ingredient/salt"],
      "text": "Cut the {cauliflower} into florets of one size. Boil them in well-salted water until just tender, and drain them very well.",
      "time": {"from": 6, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
