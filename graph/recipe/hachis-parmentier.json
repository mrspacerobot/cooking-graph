    {"thing": "ingredient/nutmeg", "amount": {"value": 1, "unit": "pinch"}, "forms": []},
    {"thing": "ingredient/minced-beef", "amount": {"value": 500, "unit": "gram"}, "forms": []},
    {"thing": "ingredient/onion", "amount": {"value": 2, "unit": "piece"}, "forms": ["form/peeled", "form/diced"]},
    {"thing": "ingredient/garlic", "amount": {"value": 1, "unit": "clove"}, "forms": ["form/minced"]},
    {"thing": "ingredient/sunflower-oil", "amount": {"value": 1, "unit": "tablespoon"}, "forms": []},
    {"thing": "ingredient/beef-stock", "amount": {"value": 150, "unit": "millilitre"}, "forms": []},
