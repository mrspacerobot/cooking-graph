{
  "id": "recipe/harira",
  "tier": "drafted",
  "names": {"en": "Harira"},
  "aliases": {},
  "makes": "dish/harira",
  "yields": {"value": 6, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/lamb-shoulder", "amount": {"value": 250, "unit": "gram"}, "forms": [], "part": "lamb"},
    {"thing": "ingredient/chickpea", "amount": {"value": 100, "unit": "gram"}, "forms": [], "part": "chickpea"},
    {"thing": "ingredient/lentil", "amount": {"value": 100, "unit": "gram"}, "forms": [], "part": "lentil"},
    {
      "thing": "ingredient/tomato",
      "amount": {"value": 600, "unit": "gram"},
      "forms": ["form/chopped"],
      "part": "tomato"
    },
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/diced"], "part": "onion"},
    {"thing": "ingredient/celery", "amount": {"value": 2, "unit": "piece"}, "forms": ["form/sliced"], "part": "celery"},
    {"thing": "ingredient/butter", "amount": {"value": 30, "unit": "gram"}, "forms": [], "part": "fat"},
    {"thing": "ingredient/ginger", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "ginger"},
    {"thing": "ingredient/turmeric", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "turmeric"},
    {"thing": "ingredient/black-pepper", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "pepper"},
    {"thing": "ingredient/cinnamon", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "cinnamon"},
    {"thing": "ingredient/saffron", "amount": {"value": 1, "unit": "pinch"}, "forms": [], "part": "saffron"},
    {"thing": "ingredient/vermicelli", "amount": {"value": 60, "unit": "gram"}, "forms": [], "part": "vermicelli"},
    {"thing": "ingredient/flour", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "flour"},
    {"thing": "ingredient/water", "amount": {"value": 2.5, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/coriander-leaf", "amount": {"value": 8, "unit": "sprig"}, "forms": [], "part": "coriander"},
    {"thing": "ingredient/parsley", "amount": {"value": 8, "unit": "sprig"}, "forms": [], "part": "parsley"},
    {"thing": "ingredient/lemon", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "lemon"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/saucepan", "equipment/mixing-bowl", "equipment/whisk",
    "equipment/wooden-spoon", "equipment/ladle", "equipment/chefs-knife", "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/soak",
      "works_on": ["ingredient/chickpea"],
      "with": ["ingredient/water"],
      "text": "Cover the dried {chickpea:plural} with plenty of cold {water} and leave them to soak overnight. Drain them.",
      "time": {"from": 8, "to": 12, "unit": "hour"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/chop",
      "works_on": ["ingredient/coriander-leaf", "ingredient/parsley"],
      "with": [],
      "text": "Chop the {coriander} and the {parsley} and keep them for the end.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/celery"],
      "with": ["ingredient/butter"],
      "text": "Melt the {fat} in the soup pot and soften the {onion} and the {celery} over a low heat, stirring now and then, until they are glossy and soft.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/lamb-shoulder", "ingredient/chickpea", "ingredient/lentil", "ingredient/tomato"],
      "with": [
        "ingredient/water", "ingredient/ginger", "ingredient/turmeric", "ingredient/black-pepper",
        "ingredient/cinnamon", "ingredient/saffron"
      ],
      "text": "Add the lamb cut in small pieces, the {chickpea:plural}, the {lentil:plural}, the {tomato:plural}, the {ginger}, the {turmeric}, the {pepper}, the {cinnamon} [saffron: and the {saffron}], and pour in most of the {water}. Bring to a boil, then lower the heat and simmer, with the lid ajar, until the {chickpea:plural} and the lamb are tender. Check a piece of lamb against a trusted guide to doneness.",
      "time": {"from": 75, "to": 100, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/broth"]
    },
    {
      "technique": "technique/thicken-with-tadouira",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/flour", "ingredient/water"],
      "text": "Whisk the {flour} into a small jug of cold {water} until it is smooth and loose. Pour it into the simmering soup in a thin stream, stirring all the time, and let the soup bubble gently until it turns silky and the taste of raw {flour} is gone.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/vermicelli"],
      "with": ["preparation/broth"],
      "text": "Break the {vermicelli} into short lengths, stir it into the soup and simmer until it is soft.",
      "time": {"from": 4, "to": 6, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/salt", "ingredient/lemon"],
      "text": "Taste the soup. Add {salt} and a squeeze of lemon juice until it tastes bright and well rounded.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/garnish",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/coriander-leaf", "ingredient/parsley"],
      "text": "Stir in most of the chopped {coriander} and {parsley} and keep a little to scatter over the bowls.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["preparation/broth"],
      "with": [],
      "text": "Ladle the soup into warm bowls and scatter over the herbs that were kept back.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
