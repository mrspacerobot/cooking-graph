      "thing": "ingredient/white-wine",
      "amount": {"value": 100, "unit": "millilitre"},
      "forms": [],
      "part": "white-wine"
    },
    {
      "thing": "ingredient/shallot",
      "amount": {"value": 1, "unit": "piece"},
      "forms": ["form/minced"],
      "part": "shallot"
    },
    {"thing": "ingredient/butter", "amount": {"value": 30, "unit": "gram"}, "forms": [], "part": "bechamel"},
    {"thing": "ingredient/flour", "amount": {"value": 20, "unit": "gram"}, "forms": [], "part": "bechamel"},
    {"thing": "ingredient/milk", "amount": {"value": 200, "unit": "millilitre"}, "forms": [], "part": "bechamel"},
    {
      "thing": "ingredient/dijon-mustard",
      "amount": {"value": 1, "unit": "teaspoon"},
      "forms": [],
      "part": "dijon-mustard"
    },
