{
  "id": "recipe/hyderabadi-dum-biryani",
  "tier": "drafted",
  "names": {"en": "Hyderabadi dum biryani"},
  "aliases": {},
  "makes": "dish/hyderabadi-dum-biryani",
  "yields": {"value": 6, "unit": "serving"},
  "ingredients": [
    {
