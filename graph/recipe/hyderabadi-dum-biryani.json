    },
    {"thing": "ingredient/basmati-rice", "amount": {"value": 500, "unit": "gram"}, "forms": [], "part": "rice"},
    {"thing": "ingredient/plain-yogurt", "amount": {"value": 250, "unit": "gram"}, "forms": [], "part": "yogurt"},
    {
      "thing": "ingredient/kashmiri-red-chilli-powder",
      "amount": {"value": 2, "unit": "teaspoon"},
      "forms": [],
      "part": "paste"
    },
    {"thing": "ingredient/turmeric", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "paste"},
    {"thing": "preparation/garam-masala", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "paste"},
    {"thing": "ingredient/garlic", "amount": {"value": 6, "unit": "clove"}, "forms": ["form/minced"], "part": "paste"},
    {"thing": "ingredient/ginger", "amount": {"value": 30, "unit": "gram"}, "forms": ["form/grated"], "part": "paste"},
    {
      "thing": "ingredient/green-chilli",
      "amount": {"value": 3, "unit": "piece"},
      "forms": ["form/sliced"],
      "part": "paste"
    },
    {"thing": "ingredient/lemon-juice", "amount": {"value": 2, "unit": "tablespoon"}, "forms": [], "part": "paste"},
    {"thing": "ingredient/onion", "amount": {"value": 4, "unit": "piece"}, "forms": [], "part": "fried-onions"},
    {"thing": "ingredient/oil", "amount": {"value": 200, "unit": "millilitre"}, "forms": [], "part": "fried-onions"},
    {"thing": "ingredient/water", "amount": {"value": 3, "unit": "litre"}, "forms": [], "part": "rice-water"},
    {"thing": "ingredient/cardamom", "amount": {"value": 5, "unit": "piece"}, "forms": [], "part": "cardamom"},
    {"thing": "ingredient/cinnamon", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "cinnamon"},
    {"thing": "ingredient/clove", "amount": {"value": 5, "unit": "piece"}, "forms": [], "part": "clove"},
    {"thing": "ingredient/bay-leaf", "amount": {"value": 2, "unit": "leaf"}, "forms": [], "part": "bay-leaf"},
    {"thing": "ingredient/saffron", "amount": {"value": 1, "unit": "pinch"}, "forms": [], "part": "saffron"},
    {"thing": "ingredient/milk", "amount": {"value": 80, "unit": "millilitre"}, "forms": [], "part": "milk"},
    {"thing": "ingredient/rose-water", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "rose-water"},
    {"thing": "ingredient/ghee", "amount": {"value": 4, "unit": "tablespoon"}, "forms": [], "part": "ghee"},
    {"thing": "ingredient/mint", "amount": {"value": 20, "unit": "gram"}, "forms": ["form/chopped"], "part": "mint"},
    {
      "thing": "ingredient/coriander-leaf",
      "amount": {"value": 20, "unit": "gram"},
      "forms": ["form/chopped"],
      "part": "coriander"
    },
    {"thing": "ingredient/salt", "amount": {"value": 4, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/flour", "amount": {"value": 150, "unit": "gram"}, "forms": [], "part": "seal-flour"},
    {"thing": "ingredient/water", "amount": {"value": 80, "unit": "millilitre"}, "forms": [], "part": "seal-water"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/handi", "equipment/tava", "equipment/colander",
    "equipment/mixing-bowl", "equipment/frying-pan", "equipment/slotted-spoon", "equipment/saucepan",
    "equipment/chefs-knife", "equipment/cutting-board", "equipment/blender"
  ],
  "steps": [
    {
      "technique": "technique/slice",
      "works_on": ["ingredient/onion"],
      "with": [],
      "text": "Halve the {fried-onions.onion} and slice them thin and even, so that they brown together.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fry-onions-deep-brown",
      "works_on": ["ingredient/onion"],
      "with": ["ingredient/oil"],
      "text": "Fry the {fried-onions.onion} in the {fried-onions.oil} in a wide pan, stirring often, until they are deep brown. Lift them out onto paper, and they crisp as they cool.",
      "time": {"from": 25, "to": 35, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/fried-onions"]
    },
    {
      "technique": "technique/make-spice-paste",
      "works_on": [
        "ingredient/garlic", "ingredient/ginger", "ingredient/green-chilli", "ingredient/kashmiri-red-chilli-powder"
      ],
      "with": ["ingredient/turmeric", "preparation/garam-masala", "ingredient/lemon-juice", "ingredient/salt"],
      "text": "Blend the {paste.garlic}, {paste.ginger} and {paste.green-chilli} with the chilli powder, the {paste.turmeric}, the {paste.garam-masala}, the {paste.lemon-juice} and a little of the {salt} to a thick paste.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/spice-paste"]
    },
    {
      "technique": "technique/marinate-in-yogurt",
      "works_on": ["ingredient/lamb-shoulder"],
      "with": [
        "ingredient/plain-yogurt", "preparation/spice-paste", "preparation/fried-onions", "ingredient/mint",
        "ingredient/coriander-leaf"
      ],
      "text": "Crush half of the fried onions into the {yogurt} with the paste, the {mint} and half of the {coriander}. Turn the raw lamb in it until every piece is coated, cover the bowl and keep it in the fridge for a long time, ideally overnight.",
      "time": {"from": 6, "to": 12, "unit": "hour"},
      "temperature": null,
      "safety_points": ["cooling-and-keeping"],
      "makes": []
    },
    {
      "technique": "technique/parboil-rice",
      "works_on": ["ingredient/basmati-rice"],
      "with": [
        "ingredient/water", "ingredient/salt", "ingredient/cardamom", "ingredient/cinnamon", "ingredient/clove",
        "ingredient/bay-leaf"
      ],
      "text": "Rinse the rice until the {rice-water} is nearly clear and soak it in cold {rice-water}. Boil it in a large pot of well-salted {rice-water} with the {cardamom}, the {cinnamon}, the {clove} and the {bay-leaf} until each grain is just short of tender with a firm core. The rice must stay under-done, as it will finish in the steam. Drain it at once.",
      "time": {"from": 4, "to": 6, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/infuse",
      "works_on": ["ingredient/milk"],
      "with": ["ingredient/saffron", "ingredient/rose-water"],
      "text": "Warm the {milk} gently, steep the {saffron} in it until the {milk} turns a deep gold[rose-water: , and stir in the {rose-water}].",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-on-dum",
      "works_on": ["ingredient/lamb-shoulder", "ingredient/basmati-rice"],
      "with": [
        "ingredient/ghee", "ingredient/saffron", "ingredient/milk", "ingredient/coriander-leaf",
        "preparation/fried-onions", "ingredient/flour", "ingredient/water"
      ],
      "text": "Spread the marinated lamb with all its marinade on the bottom of a heavy pot with a little of the {ghee}. Pile the rice over it in loose layers with the rest of the fried onions, the {coriander} and the {ghee}, and pour the {saffron} {milk} over the top. Mix the {seal-flour} and the {seal-water} to a firm dough and press a rope of it round the rim so that the lid is sealed. Set the pot on an iron plate over a medium heat for a short spell, then turn the heat to its lowest and leave it undisturbed. Rest it before breaking the seal. Check a piece of lamb against a trusted guide to doneness.",
      "time": {"from": 50, "to": 70, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/lamb-shoulder"],
      "with": [],
      "text": "Break the seal at the table. Dig down to the bottom with a flat spoon so that the lamb and the rice come up together in layers, and serve.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
