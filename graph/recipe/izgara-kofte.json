      "with": ["ingredient/water"],
      "text": "With wet hands, press portions of the mixture into short flat ovals, each with a shallow dent from the thumb.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/skewer",
      "works_on": ["ingredient/minced-beef", "ingredient/ground-lamb"],
      "with": [],
      "text": "Press each oval lightly along a flat skewer so that it grips the metal and can be turned in one move.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
