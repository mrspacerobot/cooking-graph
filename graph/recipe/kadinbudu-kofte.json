      "works_on": ["ingredient/parsley"],
      "with": [],
      "text": "[parsley: Chop the {parsley} finely.]",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/knead",
      "works_on": ["ingredient/minced-beef"],
      "with": [
        "ingredient/rice", "ingredient/kashkaval-cheese", "ingredient/parsley", "ingredient/cumin",
        "ingredient/black-pepper", "ingredient/salt"
