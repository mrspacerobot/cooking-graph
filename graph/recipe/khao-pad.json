  "steps": [
    {
      "technique": "technique/cut-into-small-pieces",
      "works_on": ["ingredient/chicken-thigh"],
      "with": [],
      "text": "Cut the {chicken} into small, thin pieces.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/slice",
      "works_on": ["ingredient/onion", "ingredient/spring-onion"],
      "with": [],
      "text": "Slice the {onion} thinly and cut the {spring-onion:plural} into short lengths.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/mince",
      "works_on": ["ingredient/garlic"],
      "with": [],
      "text": "Finely chop the {garlic}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
