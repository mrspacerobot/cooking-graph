    {
      "technique": "technique/stir-fry",
      "works_on": [],
      "with": [
        "ingredient/oil", "ingredient/garlic", "ingredient/chicken-thigh", "ingredient/onion", "ingredient/tomato"
      ],
      "text": "Heat the {oil} in a wok over high heat. Fry the {garlic} for a moment until fragrant, add the {chicken} and the {onion} and stir-fry until the {chicken} is cooked and the {onion} softened[tomato: , adding the {tomato} cut in wedges for the last moment]. Check a piece of {chicken} against a trusted guide to doneness.",
      "time": {"from": 4, "to": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/wok-scramble",
      "works_on": ["ingredient/egg"],
      "with": [],
      "text": "Push everything to one side, crack the {egg:plural} into the gap and let them puff, then scramble them into large soft curds.",
      "time": {"value": 1, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/toss",
      "works_on": ["ingredient/jasmine-rice", "ingredient/egg"],
      "with": ["ingredient/fish-sauce", "ingredient/soy-sauce", "ingredient/sugar", "ingredient/spring-onion"],
      "text": "Add the {rice}, breaking up the clumps, then the {fish-sauce}, the {soy} and the {sugar}. Toss over high heat until every grain is hot, coated and separate, then toss in the {spring-onion:plural}. Day-old {rice} from the fridge fries best.",
      "time": {"from": 3, "to": 4, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
