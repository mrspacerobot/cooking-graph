      "with": ["ingredient/lime", "ingredient/cucumber", "ingredient/coriander-leaf"],
      "text": "Serve with the {lime} cut in wedges for squeezing over[cucumber: , with slices of {cucumber} on the side][coriander: , scattered with the {coriander}].",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
