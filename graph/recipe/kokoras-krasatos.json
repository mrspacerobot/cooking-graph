{
  "id": "recipe/kokoras-krasatos",
  "tier": "drafted",
  "names": {"en": "Kokoras krasatos", "el": "Κόκορας κρασάτος", "el-Latn": "Kokoras krasatos"},
  "aliases": {},
  "makes": "dish/kokoras-krasatos",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {
      "thing": "ingredient/chicken",
      "amount": {"value": 1, "unit": "piece"},
      "forms": ["form/jointed"],
      "part": "chicken"
    },
    {"thing": "ingredient/olive-oil", "amount": {"value": 4, "unit": "tablespoon"}, "forms": [], "part": "oil"},
    {"thing": "ingredient/onion", "amount": {"value": 2, "unit": "piece"}, "forms": ["form/diced"], "part": "onion"},
    {"thing": "ingredient/garlic", "amount": {"value": 3, "unit": "clove"}, "forms": ["form/minced"], "part": "garlic"},
    {"thing": "ingredient/red-wine", "amount": {"value": 300, "unit": "millilitre"}, "forms": [], "part": "wine"},
    {"thing": "ingredient/tinned-tomatoes", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "tomato"},
    {"thing": "ingredient/cinnamon", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "cinnamon"},
    {"thing": "ingredient/allspice", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "allspice"},
    {"thing": "ingredient/bay-leaf", "amount": {"value": 2, "unit": "leaf"}, "forms": [], "part": "bay"},
    {"thing": "ingredient/water", "amount": {"value": 250, "unit": "millilitre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/black-pepper", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "pepper"},
    {"thing": "ingredient/spaghetti", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "pasta"},
    {"thing": "ingredient/water", "amount": {"value": 4, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/salt", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/kefalotyri", "amount": {"value": 80, "unit": "gram"}, "forms": [], "part": "cheese"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/dutch-oven", "equipment/stockpot", "equipment/colander", "equipment/tongs",
    "equipment/wooden-spoon", "equipment/grater", "equipment/chefs-knife", "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/sear",
      "works_on": ["ingredient/chicken"],
      "with": ["ingredient/olive-oil", "ingredient/salt", "ingredient/black-pepper"],
      "text": "Pat the pieces of {chicken} dry and season them with some of the {salt} and the {pepper}. Heat the {oil} in a heavy pot and brown them in batches, skin side first, until deep gold all over. Lift them out onto a plate.",
      "time": {"from": 12, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/fond"]
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/garlic"],
      "with": [],
      "text": "Lower the heat and soften the {onion:plural} in the fat left in the pot, stirring now and then. Add the {garlic} for the last moments.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/deglaze",
      "works_on": ["preparation/fond"],
      "with": ["ingredient/red-wine"],
      "text": "Turn up the heat, pour in the {wine} and scrape up the brown bits from the bottom. Let it bubble until the sharp smell of alcohol has gone.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/pan-sauce"]
    },
    {
      "technique": "technique/braise",
      "works_on": ["ingredient/chicken"],
      "with": [
        "preparation/pan-sauce", "ingredient/tinned-tomatoes", "ingredient/cinnamon", "ingredient/allspice",
        "ingredient/bay-leaf", "ingredient/water", "ingredient/salt"
      ],
      "text": "Stir in the {tomato}, the {cinnamon}, the {allspice}, the {bay:plural}, the {water} and the rest of the {salt}. Put the {chicken} back with its juices, cover and simmer very gently, turning the pieces now and then, until the meat comes away from the bone and the sauce is thick. Add a splash of {water} if it catches. Check the thickest piece against a trusted guide to doneness.",
      "time": {"from": 60, "to": 75, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/braising-liquid"]
    },
    {
      "technique": "technique/boil-pasta",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Near the end, boil the {pasta} in plenty of {water} salted with the rest of the {salt} until it still has a little bite, then drain it.",
      "time": {"from": 9, "to": 11, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/grate",
      "works_on": ["ingredient/kefalotyri"],
      "with": [],
      "text": "[cheese: Grate the {cheese}.]",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/chicken", "ingredient/spaghetti"],
      "with": ["preparation/braising-liquid", "ingredient/kefalotyri"],
      "text": "Take out the {cinnamon} and the {bay:plural}. Toss the {pasta} with a few spoonfuls of the sauce, heap it on plates and set the {chicken} on top with more sauce[cheese: , then scatter over the {cheese}].",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
