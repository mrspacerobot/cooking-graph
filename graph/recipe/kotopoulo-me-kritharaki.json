    {"thing": "ingredient/orzo", "amount": {"value": 350, "unit": "gram"}, "forms": [], "part": "orzo"},
    {"thing": "ingredient/kefalotyri", "amount": {"value": 60, "unit": "gram"}, "forms": [], "part": "cheese"},
