      "works_on": ["ingredient/white-beans"],
      "with": ["ingredient/water"],
      "text": "Put the beans in a pot with fresh water, bring them to a boil, then turn the heat down to a gentle simmer. Leave the lid ajar and simmer until the beans are nearly tender. Test a bean from the middle of the pot against a trusted guide to doneness.",
      "time": {"from": 40, "to": 60, "unit": "minute"},
