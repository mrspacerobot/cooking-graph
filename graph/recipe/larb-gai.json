    {"thing": "ingredient/shallot", "amount": {"value": 3, "unit": "piece"}, "forms": [], "part": "shallot"},
    {"thing": "ingredient/mint", "amount": {"value": 20, "unit": "leaf"}, "forms": [], "part": "mint"},
