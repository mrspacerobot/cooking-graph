    {"thing": "ingredient/spring-onion", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "spring-onion"},
    {"thing": "ingredient/minced-chicken", "amount": {"value": 500, "unit": "gram"}, "forms": [], "part": "chicken"},
    {"thing": "ingredient/water", "amount": {"value": 4, "unit": "tablespoon"}, "forms": [], "part": "water"},
    {"thing": "ingredient/fish-sauce", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "fish-sauce"},
    {"thing": "ingredient/lime", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "lime"},
    {"thing": "ingredient/sugar", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "sugar"},
    {"thing": "ingredient/chili-flakes", "amount": {"value": 1.5, "unit": "teaspoon"}, "forms": [], "part": "chilli"},
    {"thing": "ingredient/lettuce", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "lettuce"}
