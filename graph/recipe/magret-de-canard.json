{
  "id": "recipe/magret-de-canard",
  "tier": "drafted",
  "names": {"en": "Magret de canard"},
  "aliases": {},
  "makes": "dish/magret-de-canard",
  "yields": {"value": 2, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/duck-breast", "amount": {"value": 1, "unit": "piece"}, "forms": []},
    {"thing": "ingredient/salt", "amount": {"value": 0.75, "unit": "teaspoon"}, "forms": []},
    {"thing": "ingredient/black-pepper", "amount": {"value": 0.25, "unit": "teaspoon"}, "forms": []}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/frying-pan", "equipment/chefs-knife", "equipment/cutting-board",
    "equipment/wire-rack", "equipment/thermometer"
  ],
  "steps": [
    {
      "technique": "technique/score",
      "works_on": ["ingredient/duck-breast", "ingredient/salt"],
      "text": "Score the skin in a pattern of diamonds, cutting through the fat but not into the flesh. Dry the breast and salt both sides.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/render",
      "works_on": ["ingredient/duck-breast"],
      "text": "Lay the breast skin side down in a cold, dry pan and set it over medium-low heat. Let the fat melt out slowly, pouring it off into a bowl as it gathers, until the skin is thin, deep golden and crisp.",
      "time": {"from": 12, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/rendered-fat"]
    },
    {
      "technique": "technique/sear",
      "works_on": ["ingredient/duck-breast"],
      "text": "Turn the breast and sear the flesh side briefly over higher heat. Check its doneness with a thermometer against a trusted guide.",
      "time": {"from": 2, "to": 4, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/rest",
      "works_on": ["ingredient/duck-breast"],
      "text": "Rest it skin side up on a rack.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/duck-breast", "ingredient/black-pepper"],
      "text": "Slice it across, a little on the slant, season with the pepper and serve on warm plates. Keep the fat you poured off: it is very good for frying potatoes.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
