{
  "id": "recipe/magro-con-tomate",
  "tier": "drafted",
  "names": {"en": "Magro con tomate"},
  "aliases": {},
  "makes": "dish/magro-con-tomate",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {
      "thing": "ingredient/pork-shoulder",
      "amount": {"value": 800, "unit": "gram"},
      "forms": ["form/large-pieces"],
      "part": "pork"
    },
    {"thing": "ingredient/salt", "amount": {"value": 1.5, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/olive-oil", "amount": {"value": 4, "unit": "tablespoon"}, "forms": [], "part": "oil"},
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/chopped"], "part": "onion"},
    {"thing": "ingredient/garlic", "amount": {"value": 3, "unit": "clove"}, "forms": ["form/sliced"], "part": "garlic"},
    {"thing": "ingredient/tinned-tomatoes", "amount": {"value": 800, "unit": "gram"}, "forms": [], "part": "tomato"},
    {"thing": "ingredient/bay-leaf", "amount": {"value": 2, "unit": "leaf"}, "forms": [], "part": "bay-leaf"},
    {"thing": "ingredient/sugar", "amount": {"value": 1, "unit": "pinch"}, "forms": [], "part": "sugar"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/chefs-knife", "equipment/cutting-board", "equipment/wooden-spoon",
    "equipment/cazuela", "equipment/dutch-oven", "equipment/tongs"
  ],
  "steps": [
    {
      "technique": "technique/sear",
      "works_on": ["ingredient/pork-shoulder"],
      "with": ["ingredient/salt", "ingredient/olive-oil"],
      "text": "Season the pieces of {pork} with half the {salt}. Heat the {oil} in a heavy casserole and brown the meat in batches on all sides. Lift it out.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/fond"]
    },
    {
      "technique": "technique/fry-onions-golden",
      "works_on": ["ingredient/onion"],
      "with": ["ingredient/garlic", "preparation/fond"],
      "text": "Fry the {onion} in the same fat over a medium heat until soft and golden, adding the {garlic} for the last few moments.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/braise",
      "works_on": ["ingredient/pork-shoulder"],
      "with": ["ingredient/tinned-tomatoes", "ingredient/bay-leaf", "ingredient/salt", "ingredient/sugar"],
      "text": "Add the {tomato}, the {bay-leaf:plural} and the rest of the {salt}[sugar: , with the {sugar} if the {tomato} is sharp,] and bring to a simmer. Put the meat back, cover and cook on a low heat, stirring now and then, until the meat is tender and the sauce is thick. Check a piece against a trusted guide to doneness.",
      "time": {"from": 60, "to": 75, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/braising-liquid"]
    },
    {
      "technique": "technique/reduce",
      "works_on": ["preparation/braising-liquid"],
      "with": [],
      "text": "If the sauce is still thin, take off the lid and let it bubble down until it coats the meat. Take out the {bay-leaf:plural} and serve.",
      "time": {"from": 5, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
