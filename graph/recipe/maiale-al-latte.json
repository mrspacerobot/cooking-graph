    {"thing": "ingredient/garlic", "amount": {"value": 3, "unit": "clove"}, "forms": ["form/peeled"], "part": "garlic"},
    {"thing": "ingredient/sage", "amount": {"value": 6, "unit": "leaf"}, "forms": [], "part": "sage"},
    {"thing": "ingredient/lemon-zest", "amount": {"value": 3, "unit": "piece"}, "forms": [], "part": "lemon-zest"},
