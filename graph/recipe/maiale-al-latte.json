    "equipment/stovetop", "equipment/dutch-oven", "equipment/saucepan", "equipment/kitchen-string", "equipment/tongs",
    "equipment/wooden-spoon", "equipment/chefs-knife", "equipment/cutting-board", "equipment/vegetable-peeler"
