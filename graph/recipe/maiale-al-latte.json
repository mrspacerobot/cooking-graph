  "steps": [
    {
      "technique": "technique/sear",
      "works_on": ["ingredient/pork-loin"],
      "with": ["ingredient/butter", "ingredient/olive-oil", "ingredient/salt", "ingredient/black-pepper"],
      "text": "Tie the {pork} with string if it is not tied, and season it all over with {salt} and {black-pepper}. Melt the {butter} with the {oil} in a heavy casserole just big enough for the meat and brown it slowly on every side until deep gold.",
      "time": {"from": 12, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/fond"]
    },
    {
      "technique": "technique/braise-in-milk",
      "works_on": ["ingredient/pork-loin"],
      "with": ["ingredient/milk", "ingredient/garlic", "ingredient/sage", "ingredient/lemon-zest", "preparation/fond"],
      "text": "Pour off most of the fat. Add the {garlic}, the {sage} and the strips of {lemon-zest}, then pour in the {milk}, warmed, to come about half way up the meat. Bring it to a bare simmer, set the lid ajar and cook very gently, turning the meat now and then and scraping the bottom, until the meat is tender and the {milk} has split into golden curds. Check against a trusted guide to doneness.",
      "time": {"from": 1.5, "to": 2, "unit": "hour"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/braising-liquid"]
    },
    {
      "technique": "technique/rest",
      "works_on": ["ingredient/pork-loin"],
      "with": [],
      "text": "Lift the meat onto a board, cover it loosely and let it rest.",
      "time": {"value": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/reduce",
      "works_on": ["preparation/braising-liquid"],
      "with": [],
      "text": "Fish out the {sage} and the {lemon-zest}. Boil the curds and juices in the open pot, stirring, until they are thick and nutty brown.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/braising-liquid"],
      "with": ["ingredient/salt"],
      "text": "Taste the sauce and adjust the {salt}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/carve",
      "works_on": ["ingredient/pork-loin"],
      "with": ["preparation/braising-liquid"],
      "text": "Remove the string and cut the meat into thin slices. Lay them on a warm dish and spoon the sauce over them.",
      "time": null,
      "temperature": null,
