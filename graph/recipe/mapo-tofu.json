  "names": {"en": "Mapo tofu", "zh": "麻婆豆腐", "zh-Latn": "Mápó dòufu"},
  "aliases": {},
  "makes": "dish/mapo-tofu",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
