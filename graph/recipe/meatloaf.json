        "ingredient/parsley", "ingredient/salt", "ingredient/black-pepper"
      ],
      "text": "Add the {beef}, the {egg:plural}, the cooled {onion}, the {worcestershire}[parsley: , the {parsley}], {salt} and {black-pepper}. Mix gently with your hands until just combined, as overworking makes the loaf dense.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/shape",
      "works_on": ["ingredient/minced-beef"],
      "with": [],
      "text": "Shape the mixture into an even loaf on a lined baking sheet and pat it firm.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/bake",
      "works_on": [],
      "with": [],
      "text": "Bake in a moderate oven until the loaf is firm and starting to brown.",
      "time": {"value": 40, "unit": "minute"},
      "temperature": {"value": 180, "unit": "celsius"},
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/brush-on-a-glaze",
      "works_on": ["ingredient/minced-beef"],
      "with": ["ingredient/ketchup", "ingredient/brown-sugar", "ingredient/yellow-mustard"],
      "text": "Stir the {ketchup} with the {brown-sugar} [mustard: and the {mustard}]. Spread it over the top and sides of the loaf and bake until the glaze is sticky and dark at the edges. Check the middle against a trusted guide to doneness, then rest the loaf before slicing.",
      "time": {"from": 20, "to": 25, "unit": "minute"},
      "temperature": {"value": 180, "unit": "celsius"},
      "safety_points": ["doneness"],
      "makes": []
    }
  ]
