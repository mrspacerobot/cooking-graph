      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/drain",
      "works_on": ["ingredient/aubergine"],
      "with": [],
      "text": "Leave the flesh in a colander for a while and press out the bitter juices.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/puree",
      "works_on": ["ingredient/aubergine"],
      "with": [],
      "text": "Break the flesh down with short pulses of the blender, or chop it fine by hand, to a soft mass that still keeps some texture. Do not take it smooth.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/crush",
      "works_on": ["ingredient/garlic"],
      "with": ["ingredient/salt"],
      "text": "Crush the {garlic} with a little of the {salt} to a paste.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/chop",
      "works_on": ["ingredient/parsley"],
      "with": [],
      "text": "Chop the {parsley}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/toss",
      "works_on": ["ingredient/aubergine"],
      "with": [
        "ingredient/garlic", "ingredient/red-wine-vinegar", "ingredient/parsley", "ingredient/olive-oil",
        "ingredient/salt"
      ],
      "text": "Mix the {aubergine} with the {garlic}, the vinegar and the {parsley}, then beat in the {oil} a little at a time. Taste and adjust the {salt} and the vinegar. Chill before serving.",
