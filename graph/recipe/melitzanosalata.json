  "steps": [
    {
      "technique": "technique/char",
      "works_on": ["ingredient/aubergine"],
      "with": [],
      "text": "Set the whole {aubergine} straight on a gas flame or under a very hot grill. Turn them with tongs until the skin is black and blistered all over and the flesh has collapsed. Put them in a bowl, cover them and leave them until they are cool enough to handle. Peel off the skin and do not rinse the flesh.",
