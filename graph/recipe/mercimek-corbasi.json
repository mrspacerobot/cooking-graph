      "time": {"from": 20, "to": 25, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/broth"]
    },
    {
      "technique": "technique/puree",
      "works_on": ["ingredient/onion", "ingredient/carrot", "ingredient/potato"],
      "with": ["ingredient/red-lentil", "preparation/broth"],
      "text": "Blend the soup with the lentils until smooth, loosening it with a little hot {water} if it is too thick to pour.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/salt"],
      "text": "Return the soup to a simmer, taste it and correct the {salt}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
