      "works_on": ["preparation/broth"],
      "with": ["preparation/chilli-butter", "ingredient/lemon"],
      "text": "Ladle the soup into warm bowls, spoon the red butter over each and serve [lemon: with {lemon} cut in wedges].",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
