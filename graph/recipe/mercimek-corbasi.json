      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/carrot"],
      "with": ["ingredient/butter", "ingredient/salt"],
      "text": "Melt a little of the {butter.butter} in the pan and soften the {onion} and the {carrot} over a low heat, without colour.",
