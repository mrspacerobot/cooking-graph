  "names": {"en": "Mercimek corbasi"},
  "aliases": {},
  "makes": "dish/mercimek-corbasi",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/red-lentil", "amount": {"value": 200, "unit": "gram"}, "forms": [], "part": "lentil"},
