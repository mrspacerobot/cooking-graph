{
  "id": "recipe/mloukhieh",
  "tier": "drafted",
  "names": {"en": "Mloukhieh"},
  "aliases": {},
  "makes": "dish/mloukhieh",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/chicken", "amount": {"value": 1, "unit": "kilogram"}, "forms": [], "part": "chicken"},
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "onion"},
    {"thing": "ingredient/water", "amount": {"value": 2, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/rice", "amount": {"value": 250, "unit": "gram"}, "forms": [], "part": "rice"},
    {"thing": "ingredient/jute-leaf", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "jute-leaf"},
    {"thing": "ingredient/garlic", "amount": {"value": 8, "unit": "clove"}, "forms": [], "part": "garlic"},
    {"thing": "ingredient/coriander-leaf", "amount": {"value": 60, "unit": "gram"}, "forms": [], "part": "coriander"},
    {"thing": "ingredient/ghee", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "fat"},
    {"thing": "ingredient/lemon-juice", "amount": {"value": 60, "unit": "millilitre"}, "forms": [], "part": "lemon"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/saucepan", "equipment/frying-pan", "equipment/fine-sieve",
    "equipment/ladle", "equipment/colander", "equipment/chefs-knife", "equipment/cutting-board",
    "equipment/wooden-spoon"
  ],
  "steps": [
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/chicken"],
      "with": ["ingredient/onion", "ingredient/water", "ingredient/salt"],
      "text": "Put the {chicken} jointed into a stockpot with the {onion}, the {salt} and the {water}. Bring it slowly to a gentle simmer and cook until the {chicken} is very tender. Check the thickest piece against a trusted guide to doneness.",
      "time": {"from": 45, "to": 60, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/broth"]
    },
    {
      "technique": "technique/skim",
      "works_on": ["preparation/broth"],
      "with": [],
      "text": "Skim off the scum and the fat as they rise to the top.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/strain",
      "works_on": ["preparation/broth"],
      "with": [],
      "text": "Lift out the {chicken} and keep it warm. Strain the broth into a clean pan.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/wash-rice",
      "works_on": ["ingredient/rice"],
      "with": [],
      "text": "Wash the {rice} in several changes of cold {water} until the {water} is much less cloudy.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-rice",
      "works_on": ["ingredient/rice"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Cook the {rice} in a covered pan in a measured amount of salted {water}, until the {water} is gone, and leave it covered off the heat.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/stew-jute-leaf",
      "works_on": ["ingredient/jute-leaf"],
      "with": ["preparation/broth"],
      "text": "Bring the strained broth back to a gentle simmer and stir in the finely chopped jute leaves. Keep the pot just below a boil, uncovered, until the broth has turned dark green and silky.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/crush",
      "works_on": ["ingredient/garlic"],
      "with": ["ingredient/salt"],
      "text": "Crush the {garlic} with a little {salt} to a rough paste.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-a-taqliyeh",
      "works_on": ["ingredient/garlic", "ingredient/coriander-leaf"],
      "with": ["ingredient/ghee"],
      "text": "Heat the {fat} in a small pan, fry the {garlic} paste until it is pale gold and sweet-smelling, then add the chopped {coriander} and fry only until it wilts and darkens.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/taqliyeh"]
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/broth"],
      "with": ["preparation/taqliyeh", "ingredient/lemon-juice", "ingredient/salt"],
      "text": "Tip the sizzling taqliyeh into the stew and stir it in off the heat. Add the {lemon}, then taste and adjust the {salt}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/chicken", "ingredient/rice", "preparation/broth"],
      "with": [],
      "text": "Serve the stew in bowls, with the {rice} and the {chicken} on the side.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
