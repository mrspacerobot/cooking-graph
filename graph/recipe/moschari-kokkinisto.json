  "steps": [
    {
      "technique": "technique/sear",
      "works_on": ["ingredient/stewing-beef"],
      "with": ["ingredient/olive-oil", "ingredient/salt", "ingredient/black-pepper"],
      "text": "Pat the {beef} dry, cut it into large chunks if needed and season it with some of the {salt} and the {pepper}. Brown it in batches in the hot {oil} in a heavy pot until deep brown on all sides, and lift it out.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/fond"]
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/garlic"],
      "with": [],
      "text": "Lower the heat and soften the {onion:plural} in the fat left in the pot, then add the {garlic} for a moment.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/deglaze",
      "works_on": ["preparation/fond"],
      "with": ["ingredient/red-wine", "ingredient/tomato-paste"],
      "text": "Stir in the {tomato-paste} and let it darken for a moment, then pour in the {wine} and scrape up the brown bits. Let it bubble until the sharp smell has gone.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/pan-sauce"]
    },
    {
      "technique": "technique/braise",
      "works_on": ["ingredient/stewing-beef"],
