        "ingredient/bay-leaf", "ingredient/water", "ingredient/salt"
      ],
      "text": "Put the {beef} back with its juices and add the {tomato}, the {cinnamon}[allspice: , the {allspice}], the {bay:plural}, the {water} and the rest of the {salt}. Cover and simmer very gently, stirring now and then and adding a splash of {water} if it catches, until the meat is tender and the sauce is thick and red.",
      "time": {"from": 90, "to": 120, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/braising-liquid"]
    },
    {
      "technique": "technique/boil-pasta",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Near the end, boil the {pasta} in plenty of salted {water} until it still has a little bite, and drain it.",
      "time": {"from": 9, "to": 11, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/grate",
      "works_on": ["ingredient/kefalotyri"],
      "with": [],
      "text": "[cheese: Grate the {cheese}.]",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/stewing-beef", "ingredient/spaghetti"],
      "with": ["preparation/braising-liquid", "ingredient/kefalotyri"],
      "text": "Take out the {cinnamon} and the {bay:plural}. Toss the {pasta} with some of the sauce and serve the {beef} on top with more sauce [cheese: and the {cheese} scattered over].",
