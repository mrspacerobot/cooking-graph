{
  "id": "recipe/msemen",
  "tier": "drafted",
  "names": {"en": "Msemen"},
  "aliases": {},
  "makes": "dish/msemen",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/flour", "amount": {"value": 400, "unit": "gram"}, "forms": [], "part": "dough"},
    {"thing": "ingredient/semolina", "amount": {"value": 100, "unit": "gram"}, "forms": [], "part": "dough"},
    {"thing": "ingredient/water", "amount": {"value": 300, "unit": "millilitre"}, "forms": [], "part": "dough"},
    {"thing": "ingredient/salt", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "dough"},
    {"thing": "ingredient/sunflower-oil", "amount": {"value": 100, "unit": "millilitre"}, "forms": [], "part": "dough"},
    {"thing": "ingredient/smen", "amount": {"value": 50, "unit": "gram"}, "forms": [], "part": "fat"}
  ],
  "equipment": ["equipment/stovetop", "equipment/griddle", "equipment/mixing-bowl", "equipment/spatula"],
  "steps": [
    {
      "technique": "technique/make-msemen-dough",
      "works_on": ["ingredient/flour", "ingredient/semolina"],
      "with": ["ingredient/water", "ingredient/salt", "ingredient/sunflower-oil"],
      "text": "Mix the flour, the semolina and the salt in a bowl and add the warm water a little at a time. With oiled hands, work the dough for a good while, until it is smooth, soft and stretchy. Divide it into balls of an even size, roll each in oil, cover them and leave them to rest.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/msemen-dough"]
    },
    {
      "technique": "technique/laminate",
      "works_on": ["preparation/msemen-dough"],
      "with": ["ingredient/smen", "ingredient/semolina"],
      "text": "Take one ball and stretch it out with oiled hands on an oiled surface until it is almost see-through. Brush it with melted smen and sprinkle it with a little semolina.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fold-dough",
      "works_on": ["preparation/msemen-dough"],
      "with": ["ingredient/smen"],
      "text": "Fold the sheet over itself from the sides, like a letter, and then again, to make a small square of many layers. Do the same with every ball.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-msemen",
      "works_on": ["preparation/msemen-dough"],
      "with": ["ingredient/sunflower-oil"],
      "text": "Heat a griddle over a medium heat and oil it lightly. Press each square out with oiled fingertips, lay it on the griddle and cook until golden and speckled underneath. Turn it once and cook the other side, then clap it between the hands to open the layers and serve it hot.",
      "time": {"from": 4, "to": 6, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
