      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/rest-and-fluff",
      "works_on": ["ingredient/rice"],
      "with": [],
      "text": "Take the pot off the heat and leave it covered. Then fluff the rice and lentils gently with a fork.",
