  "ingredients": [
    {"thing": "ingredient/lamb-shoulder", "amount": {"value": 1, "unit": "kilogram"}, "forms": ["form/large-pieces"]},
    {"thing": "ingredient/sunflower-oil", "amount": {"value": 2, "unit": "tablespoon"}, "forms": []},
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/peeled", "form/diced"]},
    {"thing": "ingredient/garlic", "amount": {"value": 2, "unit": "clove"}, "forms": ["form/minced"]},
