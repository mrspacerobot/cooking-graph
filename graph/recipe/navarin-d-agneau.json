  ],
  "equipment": [
    "equipment/stovetop", "equipment/oven", "equipment/dutch-oven", "equipment/wooden-spoon", "equipment/tongs"
  ],
  "steps": [
    {
      "technique": "technique/sear",
      "works_on": ["ingredient/lamb-shoulder", "ingredient/salt", "ingredient/sunflower-oil"],
      "text": "Dry the lamb and salt it. Brown it in the oil in a heavy pot, in batches, until deep brown on all sides. Lift it out.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/fond"]
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/garlic", "ingredient/tomato-paste"],
      "text": "Pour off most of the fat. Soften the onion in the pot, then stir in the garlic and the tomato paste and let the paste darken for a moment.",
      "time": {"from": 4, "to": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sprinkle-with-flour",
      "works_on": ["ingredient/flour", "ingredient/lamb-shoulder"],
      "text": "Put the lamb back, scatter the flour over it and stir until no white shows.",
      "time": {"value": 1, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/deglaze",
      "works_on": ["preparation/fond", "ingredient/white-wine"],
      "text": "Pour in the wine and scrape the bottom of the pot clean.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/pan-sauce"]
    },
    {
      "technique": "technique/braise",
      "works_on": [
        "ingredient/lamb-shoulder", "preparation/pan-sauce", "ingredient/beef-stock", "preparation/bouquet-garni"
      ],
      "text": "Add the stock and the bouquet garni. Cover and cook at a bare simmer.",
      "time": {"value": 1, "unit": "hour"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/braising-liquid"]
    },
    {
      "technique": "technique/braise",
      "works_on": [
        "ingredient/lamb-shoulder", "preparation/braising-liquid", "ingredient/carrot", "ingredient/turnip",
        "ingredient/potato"
      ],
      "text": "Skim the fat from the surface. Add the carrots, the turnips and the potatoes, and push them under the liquid. Cover and cook until the vegetables and the lamb are tender. Check the thickest part against a trusted guide to doneness.",
      "time": {"from": 30, "to": 40, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/peas"],
      "text": "Add the peas near the end. They need only a short time.",
      "time": {"value": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/braising-liquid", "ingredient/salt", "ingredient/black-pepper"],
      "text": "Take out the bouquet garni. Taste and season.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
