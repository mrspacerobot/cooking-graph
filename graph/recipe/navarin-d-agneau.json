    {"thing": "ingredient/flour", "amount": {"value": 1, "unit": "tablespoon"}, "forms": []},
    {"thing": "ingredient/white-wine", "amount": {"value": 150, "unit": "millilitre"}, "forms": []},
    {"thing": "ingredient/beef-stock", "amount": {"value": 500, "unit": "millilitre"}, "forms": []},
    {"thing": "preparation/bouquet-garni", "amount": {"value": 1, "unit": "piece"}, "forms": []},
    {
      "thing": "ingredient/carrot",
      "amount": {"value": 300, "unit": "gram"},
      "forms": ["form/peeled", "form/large-pieces"]
    },
    {
      "thing": "ingredient/turnip",
      "amount": {"value": 300, "unit": "gram"},
      "forms": ["form/peeled", "form/large-pieces"]
    },
    {
      "thing": "ingredient/potato",
      "amount": {"value": 400, "unit": "gram"},
      "forms": ["form/peeled", "form/large-pieces"]
    },
    {"thing": "ingredient/peas", "amount": {"value": 150, "unit": "gram"}, "forms": []},
    {"thing": "ingredient/salt", "amount": {"value": 1.5, "unit": "teaspoon"}, "forms": []},
