{
  "id": "recipe/nikujaga",
  "tier": "drafted",
  "names": {"en": "Nikujaga"},
  "aliases": {},
  "makes": "dish/nikujaga",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/kombu", "amount": {"value": 10, "unit": "gram"}, "forms": [], "part": "dashi"},
    {"thing": "ingredient/bonito-flakes", "amount": {"value": 15, "unit": "gram"}, "forms": [], "part": "dashi"},
    {"thing": "ingredient/water", "amount": {"value": 600, "unit": "millilitre"}, "forms": [], "part": "dashi"},
    {
      "thing": "ingredient/pork-belly",
      "amount": {"value": 200, "unit": "gram"},
      "forms": ["form/sliced"],
      "part": "meat"
    },
    {
      "thing": "ingredient/potato",
      "amount": {"value": 500, "unit": "gram"},
      "forms": ["form/peeled"],
      "part": "potato"
    },
    {
      "thing": "ingredient/carrot",
      "amount": {"value": 150, "unit": "gram"},
      "forms": ["form/peeled"],
      "part": "carrot"
    },
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/peeled"], "part": "onion"},
    {"thing": "ingredient/shirataki", "amount": {"value": 200, "unit": "gram"}, "forms": [], "part": "shirataki"},
    {"thing": "ingredient/oil", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "oil"},
    {"thing": "ingredient/sake", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "sake"},
    {"thing": "ingredient/mirin", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "mirin"},
    {"thing": "ingredient/sugar", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "sugar"},
    {"thing": "ingredient/soy-sauce", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "soy"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/saucepan", "equipment/dutch-oven", "equipment/drop-lid", "equipment/fine-sieve",
    "equipment/colander", "equipment/mixing-bowl", "equipment/chefs-knife", "equipment/paring-knife",
    "equipment/cutting-board", "equipment/ladle"
  ],
  "steps": [
    {
      "technique": "technique/make-dashi",
      "works_on": ["ingredient/kombu", "ingredient/bonito-flakes"],
      "with": ["ingredient/water"],
      "text": "Put the kelp in the cold {dashi.water} and warm it slowly. Lift the kelp out just before the {dashi.water} boils. Turn off the heat, scatter in the {dashi.bonito-flakes:plural} and let them sink by themselves.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/dashi"]
    },
    {
      "technique": "technique/strain",
      "works_on": ["preparation/dashi"],
      "with": [],
      "text": "Pour the dashi through a fine sieve into a clean pot. Do not press on the {dashi.bonito-flakes:plural}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/pour-boiling-water-over",
      "works_on": ["ingredient/shirataki"],
      "with": ["ingredient/water"],
      "text": "Put the konjac strands in a colander and pour boiling {dashi.water} over them to take off the smell of their packing {dashi.water}. Drain well.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cut-into-chunks",
      "works_on": ["ingredient/potato", "ingredient/carrot"],
      "with": [],
      "text": "Cut the {potato:plural} and the {carrot} into large, bite-sized chunks of about the same size.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/bevel-edges",
      "works_on": ["ingredient/potato", "ingredient/carrot"],
      "with": [],
      "text": "Shave the sharp corners from each chunk, so that the pieces hold their shape through the long simmer.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/soak-in-water",
      "works_on": ["ingredient/potato"],
      "with": ["ingredient/water"],
      "text": "Put the {potato} chunks in cold {dashi.water} for a short while to rinse off loose starch. Drain them well.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/slice",
      "works_on": ["ingredient/onion"],
      "with": [],
      "text": "Cut the {onion} into thick wedges, keeping the layers together.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/stir-fry",
      "works_on": ["ingredient/pork-belly", "ingredient/potato", "ingredient/carrot"],
      "with": ["ingredient/oil"],
      "text": "Heat the {oil} in a wide pot. Stir-fry the meat until its surface is pale gold, then add the {potato:plural} and the {carrot} and stir until they are coated with the fat and shining.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": [
        "preparation/dashi", "ingredient/pork-belly", "ingredient/potato", "ingredient/carrot", "ingredient/onion"
      ],
      "with": ["ingredient/sake", "ingredient/mirin", "ingredient/sugar", "ingredient/shirataki"],
      "text": "Pour in the dashi and the {sake} and bring it up to a boil. Add the {onion}, the konjac strands, the {mirin} and the {sugar}, and turn the heat down to a gentle simmer.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/skim",
      "works_on": ["preparation/dashi"],
      "with": [],
      "text": "Skim off the scum that rises, so that the broth stays clear.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cover-with-a-drop-lid",
      "works_on": ["ingredient/potato", "ingredient/carrot"],
      "with": [],
      "text": "Lay a drop lid on top of the food and let it simmer gently until the {potato:plural} are tender and the liquid has reduced by about a third. Check a piece of the meat against a trusted guide to doneness.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/dashi"],
      "with": ["ingredient/soy-sauce"],
      "text": "Stir in the {soy}, simmer a little longer so that it soaks in, and taste. Adjust with a little more {sugar} or {soy} if the pot tastes flat.",
      "time": {"from": 3, "to": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": [
        "ingredient/pork-belly", "ingredient/potato", "ingredient/carrot", "ingredient/onion", "preparation/dashi"
      ],
      "with": [],
      "text": "Serve the pieces in small bowls with a spoonful of the glossy broth.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
