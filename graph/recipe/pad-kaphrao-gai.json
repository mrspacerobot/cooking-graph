      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/pound",
      "works_on": ["ingredient/garlic"],
      "with": ["ingredient/birds-eye-chilli"],
      "text": "Pound the {garlic} and the {chilli:plural} to a coarse paste in a mortar.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/brown-mince",
      "works_on": ["ingredient/minced-chicken"],
      "with": ["ingredient/oil", "ingredient/garlic", "ingredient/birds-eye-chilli"],
      "text": "Heat the smaller amount of {oil} in a wok over high heat. Fry the pounded paste for a moment until fragrant, then add the {chicken} and fry, breaking it up, until it is browned in places. Check it against a trusted guide to doneness.",
      "time": {"from": 3, "to": 4, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/stir-fry",
      "works_on": [],
      "with": [
        "ingredient/minced-chicken", "ingredient/oyster-sauce", "ingredient/fish-sauce", "ingredient/soy-sauce",
        "ingredient/dark-soy-sauce", "ingredient/sugar", "ingredient/water", "ingredient/holy-basil"
      ],
      "text": "Add the {oyster-sauce}, the {fish-sauce}, the {soy}[dark-soy: , the {dark-soy}] and the {sugar} with the {water}, and toss until the meat is glossy and the wok nearly dry. Throw in the {basil}, toss just until it wilts, and take the wok off the heat. When it cannot be found, Thai basil is the usual stand-in and tastes sweeter.",
      "time": {"from": 1, "to": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fry-a-crispy-egg",
      "works_on": ["ingredient/egg"],
      "with": ["ingredient/oil"],
      "text": "[egg: In a clean wok heat the larger amount of {oil} until it shimmers. Crack an {egg} into a small bowl, slide it in and spoon the hot fat over it until the edges are brown, lacy and crisp but the yolk is still runny. Lift it out to drain and fry the rest the same way.]",
      "time": {"from": 4, "to": 6, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/minced-chicken", "ingredient/jasmine-rice"],
      "with": ["ingredient/egg"],
      "text": "Serve the stir-fry over the {rice}[egg: , each plate topped with a crisp {egg}].",
      "time": null,
