      "with": ["ingredient/vegetable-stock", "ingredient/salt"],
      "text": "Heat the {liquid} in a saucepan. Stir the {peas:plural} into the pot, frozen ones straight from the bag, with a ladle of the hot {liquid} and a little of the {salt}. Simmer until the {peas:plural} are tender and sweet.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
