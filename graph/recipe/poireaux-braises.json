{
  "id": "recipe/poireaux-braises",
  "tier": "drafted",
  "names": {"en": "Poireaux braisés"},
  "aliases": {},
  "makes": "dish/poireaux-braises",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/leek", "amount": {"value": 6, "unit": "piece"}, "forms": [], "part": "leek"},
    {"thing": "ingredient/butter", "amount": {"value": 40, "unit": "gram"}, "forms": [], "part": "butter"},
    {"thing": "ingredient/chicken-stock", "amount": {"value": 250, "unit": "millilitre"}, "forms": [], "part": "stock"},
    {"thing": "ingredient/thyme", "amount": {"value": 2, "unit": "sprig"}, "forms": [], "part": "thyme"},
    {"thing": "ingredient/salt", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {
      "thing": "ingredient/black-pepper",
      "amount": {"value": 0.25, "unit": "teaspoon"},
      "forms": [],
      "part": "black-pepper"
    }
  ],
  "equipment": ["equipment/stovetop", "equipment/saute-pan", "equipment/parchment-paper"],
  "steps": [
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/leek"],
      "with": ["ingredient/butter", "ingredient/salt"],
      "text": "Trim the {leek:plural} to their white and pale green parts, halve them lengthwise and wash out the grit, keeping each half in one piece. Lay them cut side down in the {butter} in a wide pan over low heat, with the {salt}, and let them soften a little without colour.",
      "time": {"from": 5, "to": 6, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/braise",
      "works_on": ["ingredient/leek"],
      "with": ["ingredient/chicken-stock", "ingredient/thyme"],
      "text": "Add the {stock} and the {thyme}. The liquid should come about half way up the {leek:plural}. Cover with a round of paper and a lid, and cook very gently until the tip of a knife meets no resistance.",
      "time": {"from": 25, "to": 30, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/braising-liquid"]
    },
    {
      "technique": "technique/reduce",
      "works_on": ["preparation/braising-liquid"],
      "with": [],
      "text": "Take off the lid and the paper. Boil the liquid down around the {leek:plural} until it is syrupy and coats them.",
      "time": {"from": 3, "to": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": [],
      "with": ["ingredient/black-pepper", "ingredient/salt"],
      "text": "Season with the {black-pepper}, taste for {salt} and serve warm.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
