{
  "id": "recipe/polenta-ai-funghi",
  "tier": "drafted",
  "names": {"en": "Polenta ai funghi", "fr": "Polenta aux champignons"},
  "aliases": {},
  "makes": "dish/polenta-ai-funghi",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/polenta", "amount": {"value": 250, "unit": "gram"}, "forms": [], "part": "polenta"},
    {"thing": "ingredient/water", "amount": {"value": 1.2, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/water", "amount": {"value": 250, "unit": "millilitre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/porcini-mushroom", "amount": {"value": 20, "unit": "gram"}, "forms": [], "part": "mushroom"},
    {
      "thing": "ingredient/mushroom",
      "amount": {"value": 300, "unit": "gram"},
      "forms": ["form/sliced"],
      "part": "mushroom"
    },
    {"thing": "ingredient/garlic", "amount": {"value": 2, "unit": "clove"}, "forms": ["form/sliced"], "part": "garlic"},
    {"thing": "ingredient/olive-oil", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "oil"},
    {"thing": "ingredient/butter", "amount": {"value": 30, "unit": "gram"}, "forms": [], "part": "finish"},
    {
      "thing": "ingredient/parmesan",
      "amount": {"value": 40, "unit": "gram"},
      "forms": ["form/grated"],
      "part": "cheese"
    },
    {
      "thing": "ingredient/parsley",
      "amount": {"value": 15, "unit": "gram"},
      "forms": ["form/chopped"],
      "part": "parsley"
    }
  ],
  "equipment": [
    "equipment/stovetop", "equipment/dutch-oven", "equipment/saute-pan", "equipment/mixing-bowl",
