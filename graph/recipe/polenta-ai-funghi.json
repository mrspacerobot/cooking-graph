  ],
  "steps": [
    {
      "technique": "technique/soak-dried-mushrooms",
      "works_on": ["ingredient/porcini-mushroom"],
      "with": ["ingredient/water"],
      "text": "Rinse the dried {mushroom.porcini-mushroom} quickly, cover them with warm {water} and leave them until plump and soft. Lift them out, squeeze them over the bowl and pour the dark {water} through a fine sieve, leaving the grit behind. Keep the {water}.",
      "time": {"from": 20, "to": 30, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/saute",
      "works_on": ["ingredient/mushroom", "ingredient/porcini-mushroom", "ingredient/garlic"],
      "with": ["ingredient/olive-oil"],
      "text": "Slice the soaked {mushroom.porcini-mushroom}. Heat the {oil} in a wide pan over high heat, add the fresh {mushroom.mushroom:plural} in a single layer, in lots if need be, and leave them until they take colour. Add the {mushroom.porcini-mushroom} and the {garlic} and toss for a short while, until the {garlic} is fragrant.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/mushroom"],
      "with": ["ingredient/water"],
      "text": "Pour in the strained soaking {water} and let it bubble until it has nearly gone and clings to the {mushroom.mushroom:plural} as a dark glaze.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/mushroom"],
      "with": ["ingredient/salt"],
      "text": "Taste and adjust the {salt}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-polenta",
      "works_on": ["ingredient/polenta"],
      "with": ["ingredient/water", "ingredient/salt", "ingredient/butter", "ingredient/parmesan"],
      "text": "Bring the {water} to a boil with the {salt}. Lower the heat and let the {polenta} fall in a thin stream, stirring all the while. Cook over the lowest heat, stirring often and adding a splash of hot {water} if it stiffens, until it is smooth and the grains are tender. Beat in the {finish} and half the cheese off the heat.",
      "time": {"from": 40, "to": 50, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/chop",
      "works_on": ["ingredient/parsley"],
      "with": [],
      "text": "Chop the {parsley}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/mushroom"],
      "with": ["ingredient/polenta", "ingredient/parsley", "ingredient/parmesan"],
      "text": "Spoon the soft {polenta} into warm shallow bowls, make a hollow in each and heap the {mushroom.mushroom:plural} in it. Scatter with the {parsley} and the rest of the cheese.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
