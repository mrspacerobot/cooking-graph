  "steps": [
    {
      "technique": "technique/skim",
      "works_on": ["ingredient/stewing-beef", "ingredient/water"],
      "text": "Put the beef in a large pot and cover it with the cold water. Bring it up slowly, and lift off the grey foam as it rises, until no more comes.",
      "time": {"from": 20, "to": 30, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": [
        "ingredient/stewing-beef", "ingredient/onion", "ingredient/clove", "preparation/bouquet-garni",
        "ingredient/salt", "ingredient/black-pepper"
      ],
      "text": "Stick the cloves into the onion. Add it with the bouquet garni, the salt and the pepper. Simmer very gently, lid ajar, and never let it boil.",
      "time": {"value": 2, "unit": "hour"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/stewing-beef", "ingredient/carrot", "ingredient/turnip", "ingredient/leek"],
      "text": "Add the carrots and the turnips, whole or halved, and the leeks tied in a bundle. Simmer until a knife meets no resistance in the meat and the vegetables are tender.",
      "time": {"from": 45, "to": 60, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/poach",
      "works_on": ["ingredient/marrow-bone"],
      "text": "Poach the marrow bones apart, in a ladleful of the broth in a small pan, so that the marrow does not melt away into the pot.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/salt"],
      "text": "Skim the fat from the broth, taste it and add salt if it needs it.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": [
        "ingredient/stewing-beef", "ingredient/marrow-bone", "ingredient/carrot", "ingredient/turnip",
        "ingredient/leek", "ingredient/dijon-mustard", "ingredient/cornichons"
      ],
      "text": "Serve the broth first, in warm bowls. Then slice the beef across the grain and serve it with the vegetables and the marrow bones, moistened with a little broth, with the mustard and the cornichons on the side.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
