    {"thing": "ingredient/turnip", "amount": {"value": 4, "unit": "piece"}, "forms": ["form/peeled"]},
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/peeled"]},
