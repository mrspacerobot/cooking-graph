{
  "id": "recipe/pot-au-feu",
  "tier": "drafted",
  "names": {"en": "Pot-au-feu"},
  "aliases": {},
  "makes": "dish/pot-au-feu",
  "yields": {"value": 6, "unit": "serving"},
  "ingredients": [
    {
      "thing": "ingredient/stewing-beef",
      "amount": {"value": 1.2, "unit": "kilogram"},
      "forms": ["form/large-pieces"],
      "part": "stewing-beef"
    },
    {"thing": "ingredient/marrow-bone", "amount": {"value": 4, "unit": "piece"}, "forms": [], "part": "marrow-bone"},
    {"thing": "ingredient/carrot", "amount": {"value": 6, "unit": "piece"}, "forms": ["form/peeled"], "part": "carrot"},
    {"thing": "ingredient/leek", "amount": {"value": 4, "unit": "piece"}, "forms": [], "part": "leek"},
    {"thing": "ingredient/turnip", "amount": {"value": 4, "unit": "piece"}, "forms": ["form/peeled"], "part": "turnip"},
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/peeled"], "part": "onion"},
    {"thing": "ingredient/clove", "amount": {"value": 3, "unit": "piece"}, "forms": [], "part": "clove"},
    {
      "thing": "preparation/bouquet-garni",
      "amount": {"value": 1, "unit": "piece"},
      "forms": [],
      "part": "bouquet-garni"
    },
    {"thing": "ingredient/water", "amount": {"value": 4, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/salt", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "salt"},
    {
      "thing": "ingredient/black-pepper",
      "amount": {"value": 0.5, "unit": "teaspoon"},
      "forms": [],
      "part": "black-pepper"
    },
    {
      "thing": "ingredient/dijon-mustard",
      "amount": {"value": 3, "unit": "tablespoon"},
      "forms": [],
      "part": "dijon-mustard"
    },
    {"thing": "ingredient/cornichons", "amount": {"value": 12, "unit": "piece"}, "forms": [], "part": "cornichons"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/saucepan", "equipment/ladle", "equipment/kitchen-string",
    "equipment/chefs-knife"
  ],
  "steps": [
    {
      "technique": "technique/skim",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/stewing-beef", "ingredient/water"],
      "text": "Put the beef in a large pot and cover it with the cold {water}. Bring it up slowly, and lift off the grey foam as it rises, until no more comes.",
      "time": {"from": 20, "to": 30, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/broth"]
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/stewing-beef"],
      "with": [
        "ingredient/onion", "ingredient/clove", "preparation/bouquet-garni", "ingredient/salt",
        "ingredient/black-pepper"
      ],
      "text": "Stick the {clove} into the {onion}. Add it with the {bouquet-garni}, the {salt} and the {black-pepper}. Simmer very gently, lid ajar, and never let it boil.",
      "time": {"value": 2, "unit": "hour"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/stewing-beef", "ingredient/carrot", "ingredient/turnip", "ingredient/leek"],
      "with": [],
      "text": "Add the {carrot} and the {turnip}, whole or halved, and the {leek} tied in a bundle. Simmer until a knife meets no resistance in the meat and the vegetables are tender.",
      "time": {"from": 45, "to": 60, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/poach",
      "works_on": ["ingredient/marrow-bone"],
      "with": ["preparation/broth"],
      "text": "Poach the {marrow-bone} apart, in a small pan with enough of the broth to cover them, so that the marrow does not melt away into the pot.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/salt"],
      "text": "Skim the fat from the broth, taste it and add {salt} if it needs it.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": [
        "preparation/broth", "ingredient/stewing-beef", "ingredient/marrow-bone", "ingredient/carrot",
        "ingredient/turnip", "ingredient/leek"
      ],
      "with": ["ingredient/dijon-mustard", "ingredient/cornichons"],
      "text": "Serve the broth first, in warm bowls. Then slice the beef across the grain and serve it with the vegetables and the {marrow-bone}, moistened with a little broth. [dijon-mustard: Serve with the {dijon-mustard} on the side.] [cornichons: Serve with the {cornichons} on the side.]",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
