        "ingredient/black-pepper"
      ],
      "text": "Stick the {clove} into the {onion} and add it with the {celery}, the {bouquet-garni} and the {black-pepper}. Poach at a bare tremble, lid ajar. The {water} must never boil.",
      "time": {"value": 45, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
