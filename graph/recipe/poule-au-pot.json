      "works_on": ["ingredient/chicken", "ingredient/carrot", "ingredient/turnip", "ingredient/leek"],
      "with": [],
      "text": "Add the {carrot}, the {turnip} and the {leek} tied in a bundle. Go on poaching until the vegetables are tender and the leg moves freely in its joint. Check the thickest part of the thigh against a trusted guide to doneness.",
      "time": {"from": 35, "to": 45, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/salt"],
      "text": "Lift the bird and the vegetables onto a warm dish. Skim the fat from the broth, taste it and adjust the {salt}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": [
        "preparation/broth", "ingredient/chicken", "ingredient/carrot", "ingredient/turnip", "ingredient/leek"
      ],
      "with": [],
      "text": "Serve the broth first, in warm bowls. Then carve the {chicken} and serve it with the vegetables, moistened with a ladle of broth.",
