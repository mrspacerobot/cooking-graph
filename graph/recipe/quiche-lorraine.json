    {"thing": "ingredient/salt", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/flour", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "flour"},
    {"thing": "ingredient/bacon", "amount": {"value": 200, "unit": "gram"}, "forms": [], "part": "bacon"},
    {"thing": "ingredient/egg", "amount": {"value": 3, "unit": "piece"}, "forms": [], "part": "egg"},
    {"thing": "ingredient/cream", "amount": {"value": 200, "unit": "millilitre"}, "forms": [], "part": "custard"},
    {"thing": "ingredient/milk", "amount": {"value": 100, "unit": "millilitre"}, "forms": [], "part": "milk"},
