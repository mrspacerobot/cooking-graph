      "works_on": ["ingredient/skate"],
      "with": ["preparation/court-bouillon"],
      "text": "Lay the {skate} in a wide pan and cover it with the cold {court-bouillon}. Bring it slowly to a bare tremble and poach until the flesh comes away from the cartilage at the thickest point. The time counts from the first tremble. Check the thickest part against a trusted guide to doneness.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/skate"],
      "with": ["ingredient/salt", "ingredient/capers", "ingredient/parsley"],
      "text": "Lift the wings out, drain them well and scrape off the skin. Set them on hot plates, season them lightly with the {salt} and scatter with the {capers:plural} [parsley: and the {parsley}].",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-brown-butter",
      "works_on": ["ingredient/butter"],
      "with": [],
      "text": "Cook the {brown-butter} in a pan until it foams, falls quiet and smells of hazelnuts.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/brown-butter"]
    },
    {
      "technique": "technique/plate",
      "works_on": ["preparation/brown-butter", "ingredient/skate"],
      "with": ["ingredient/red-wine-vinegar"],
      "text": "Pour the {brown-butter} over the fish at once. Swirl the vinegar in the hot pan for a moment and pour it over too. Serve while it still sizzles.",
