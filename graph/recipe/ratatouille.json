{
  "id": "recipe/ratatouille",
  "tier": "drafted",
  "names": {"en": "Ratatouille"},
  "aliases": {},
  "makes": "dish/ratatouille",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/aubergine", "amount": {"value": 350, "unit": "gram"}, "forms": []},
    {"thing": "ingredient/courgette", "amount": {"value": 400, "unit": "gram"}, "forms": []},
    {"thing": "ingredient/bell-pepper", "amount": {"value": 2, "unit": "piece"}, "forms": []},
    {"thing": "ingredient/tomato", "amount": {"value": 500, "unit": "gram"}, "forms": []},
    {"thing": "ingredient/onion", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/peeled"]},
    {"thing": "ingredient/garlic", "amount": {"value": 3, "unit": "clove"}, "forms": ["form/minced"]},
    {"thing": "ingredient/thyme", "amount": {"value": 3, "unit": "sprig"}, "forms": []},
    {"thing": "ingredient/bay-leaf", "amount": {"value": 1, "unit": "leaf"}, "forms": []},
    {"thing": "ingredient/olive-oil", "amount": {"value": 6, "unit": "tablespoon"}, "forms": []},
    {"thing": "ingredient/salt", "amount": {"value": 1.5, "unit": "teaspoon"}, "forms": []},
    {"thing": "ingredient/black-pepper", "amount": {"value": 0.25, "unit": "teaspoon"}, "forms": []}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/frying-pan", "equipment/dutch-oven", "equipment/chefs-knife",
    "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/dice",
      "works_on": ["ingredient/aubergine", "ingredient/courgette", "ingredient/bell-pepper", "ingredient/onion"],
      "text": "Cut the aubergine, the courgettes, the peppers and the onion into even dice, each in its own pile. Leave the skin on the aubergine and the courgettes.",
      "time": null,
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/dice",
      "works_on": ["ingredient/tomato"],
      "text": "Cut the tomatoes into rough dice and keep their juice.",
      "time": null,
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/saute",
      "works_on": ["ingredient/olive-oil", "ingredient/aubergine", "ingredient/salt"],
      "text": "Heat a third of the oil in a wide pan over high heat. Brown the aubergine with a little of the salt, then tip it into a bowl.",
      "time": {"from": 6, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/saute",
      "works_on": ["ingredient/olive-oil", "ingredient/courgette"],
      "text": "Brown the courgettes in the same pan with a little more oil, and add them to the bowl.",
      "time": {"from": 5, "to": 6, "unit": "minute"},
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/olive-oil", "ingredient/onion", "ingredient/bell-pepper", "ingredient/salt"],
      "text": "Soften the onion and the peppers in the rest of the oil in a heavy pot over low heat, with a little salt, until limp and sweet.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/simmer",
      "works_on": [
        "ingredient/garlic", "ingredient/tomato", "ingredient/thyme", "ingredient/bay-leaf", "ingredient/aubergine",
        "ingredient/courgette"
      ],
      "text": "Stir in the garlic until it smells sweet. Add the tomatoes, the thyme and the bay leaf, then the browned vegetables. Simmer gently, lid ajar, until everything is soft and the juices have thickened.",
      "time": {"from": 35, "to": 45, "unit": "minute"},
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/salt", "ingredient/black-pepper"],
      "text": "Take out the thyme stalks and the bay leaf. Taste, and season with the rest of the salt and the pepper. Serve warm or at room temperature.",
      "time": null,
      "temperature": null,
      "safety_points": []
    }
  ]
}
