      "works_on": ["ingredient/pork-belly"],
      "with": ["ingredient/water"],
      "text": "Put the cubes in a pan of cold {water}, bring it to a boil and boil until grey scum rises. Drain and rinse off the scum.",
      "time": {"from": 3, "to": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/slice",
      "works_on": ["ingredient/spring-onion"],
