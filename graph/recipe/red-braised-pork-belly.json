      "text": "Cut the {ginger} into thick slices and the {spring-onion:plural} into long lengths.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-a-caramel",
      "works_on": ["ingredient/sugar"],
      "with": ["ingredient/oil"],
      "text": "Warm the {oil} and the {sugar} in a wok over low heat, stirring, until the {sugar} melts and turns the colour of dark amber, with small bubbles.",
