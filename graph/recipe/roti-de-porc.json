    {"thing": "ingredient/thyme", "amount": {"value": 4, "unit": "sprig"}, "forms": [], "part": "thyme"},
    {
      "thing": "ingredient/white-wine",
      "amount": {"value": 150, "unit": "millilitre"},
      "forms": [],
      "part": "white-wine"
    },
    {"thing": "ingredient/water", "amount": {"value": 100, "unit": "millilitre"}, "forms": [], "part": "water"},
