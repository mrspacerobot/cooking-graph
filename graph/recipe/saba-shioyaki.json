    {"thing": "ingredient/daikon", "amount": {"value": 150, "unit": "gram"}, "forms": [], "part": "daikon"},
    {"thing": "ingredient/sudachi", "amount": {"value": 2, "unit": "piece"}, "forms": [], "part": "citrus"},
