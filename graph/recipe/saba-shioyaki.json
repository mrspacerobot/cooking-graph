      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/grate-daikon",
      "works_on": ["ingredient/daikon"],
      "with": [],
      "text": "Grate the {daikon} and let the juice drain a little in a fine sieve.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/grill",
      "works_on": ["ingredient/mackerel"],
      "with": [],
      "text": "Heat the grill until it is very hot. Lay the fish skin side up on a rack in a tray close to the heat and grill until the skin blisters and browns, then turn it once and grill the other side. Check the thickest part against a trusted guide to doneness.",
      "time": {"from": 8, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/garnish",
      "works_on": ["ingredient/mackerel"],
      "with": ["ingredient/daikon", "ingredient/soy-sauce", "ingredient/sudachi"],
      "text": "Set the fish on a plate with a heap of grated {daikon}[soy: , a few drops of {soy} on the {daikon}] and a halved {citrus} to squeeze over.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
