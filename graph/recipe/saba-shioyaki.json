  "steps": [
    {
      "technique": "technique/salt-fish",
      "works_on": ["ingredient/mackerel"],
      "with": ["ingredient/salt"],
      "text": "Pat the {mackerel} dry and sprinkle {salt} evenly over both sides. Leave it until beads of water show on the skin, then wipe them off with paper.",
