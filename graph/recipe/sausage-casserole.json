      "with": ["ingredient/olive-oil"],
      "text": "Heat the {oil} in a wide casserole over a medium heat and brown the {sausages:plural} all over, turning them often. They need only colour here, as they finish in the sauce. Lift them out onto a plate.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fry-onions-golden",
      "works_on": ["ingredient/onion"],
      "with": [],
      "text": "Fry the {onion:plural} in the fat left in the pan, stirring now and then, until soft and golden.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/carrot", "ingredient/garlic"],
      "with": [],
      "text": "Add the {carrot:plural} and the {garlic} and cook gently until the {carrot:plural} begin to soften.",
      "time": {"value": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
