      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/garlic"],
      "with": [],
      "text": "Pour off most of the fat and keep every brown bit. Stir the garlic in the pan just until it smells sweet.",
