      "makes": ["preparation/bread-dough"]
    },
    {
      "technique": "technique/proof",
      "works_on": ["preparation/bread-dough"],
      "with": [],
      "text": "Cover the bowl and leave the dough in a warm place until it has swelled well and is full of bubbles.",
      "time": {"from": 60, "to": 90, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fry-sfenj",
      "works_on": ["preparation/bread-dough"],
      "with": ["ingredient/sunflower-oil", "ingredient/sugar"],
      "text": "Heat the {oil} in a deep pot. With a wet hand, pull off a lump of dough, flatten it and poke a hole through the middle with a wet thumb. Slide the ring into the {oil}, and fry a few at a time, turning each once, until puffed and golden on both sides. Lift them out, drain them, and toss them in the rest of the {sugar} while they are still warm.",
      "time": {"from": 3, "to": 4, "unit": "minute"},
