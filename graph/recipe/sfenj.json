    {
      "technique": "technique/beat-sfenj-dough",
      "works_on": ["ingredient/flour"],
      "with": ["ingredient/water", "ingredient/yeast", "ingredient/salt", "ingredient/sugar"],
      "text": "Stir the {yeast} into a little of the warm {water} with a spoonful of the {sugar} and let it foam. Put the {flour} and the {salt} in a large bowl, pour in the {yeast} {water} and the rest of the {water}, and beat with a wet hand, lifting and slapping the dough, until it is smooth, stretchy and full of bubbles.",
      "time": {"from": 10, "to": 15, "unit": "minute"},
