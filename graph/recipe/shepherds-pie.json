    {
      "technique": "technique/layer",
      "works_on": ["ingredient/ground-lamb", "preparation/mashed-potato"],
      "with": ["ingredient/cheddar"],
      "text": "Spoon the meat into a baking dish and leave it to cool a little. Spread the mash over the top and rough it up with a fork[cheese: , then scatter over the {cheese}].",
