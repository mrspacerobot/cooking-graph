      "works_on": ["ingredient/ground-lamb"],
      "with": ["ingredient/oil"],
      "text": "Heat the {oil} in a wide pan over a high heat. Add the {lamb}, break it up with a wooden spoon and fry, stirring only now and then, until the liquid has cooked off and the meat is well browned. Spoon off most of the fat.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/onion", "ingredient/carrot", "ingredient/garlic"],
      "with": [],
