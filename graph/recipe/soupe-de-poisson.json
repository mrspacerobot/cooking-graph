      "text": "Blend the soup in short bursts, bones and all, only until everything is broken up.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/strain",
      "works_on": ["preparation/broth"],
      "with": [],
      "text": "Press the soup through a fine sieve with the back of a ladle, to take every drop and leave the bones behind.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/broth"],
      "with": ["ingredient/salt"],
      "text": "Bring the soup back to a simmer, taste it and correct the salt.",
