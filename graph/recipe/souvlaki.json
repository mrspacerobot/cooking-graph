  "steps": [
    {
      "technique": "technique/trim",
      "works_on": ["ingredient/pork-tenderloin"],
      "with": [],
      "text": "Trim away the silver skin and any hard fat, then cut the pork into cubes of an even size.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/crush",
      "works_on": ["ingredient/garlic"],
      "with": ["ingredient/salt"],
      "text": "Crush the {garlic} with a little of the {salt} to a paste.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/marinate-in-oil-and-lemon",
      "works_on": ["ingredient/pork-tenderloin"],
