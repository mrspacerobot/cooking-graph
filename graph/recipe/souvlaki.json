        "ingredient/black-pepper"
      ],
      "text": "Turn the pork in the {marinade} with the {garlic}, the {oregano}, the rest of the {salt} and the {pepper}. Cover and keep it in the cold for a short while. Do not leave it long, or the {lemon} dries the meat.",
      "time": {"from": 30, "to": 60, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/skewer",
      "works_on": ["ingredient/pork-tenderloin"],
      "with": [],
      "text": "Thread the cubes on skewers, snugly, with a little room between them. Soak wooden skewers in water first.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/slice",
      "works_on": ["ingredient/tomato", "ingredient/onion"],
      "with": [],
      "text": "Slice the {tomato} and slice the {onion} thin.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/grill",
      "works_on": ["ingredient/pork-tenderloin"],
      "with": [],
      "text": "Grill the skewers close to a fierce heat, turning them now and then, until the pork is browned at the edges. Check a cube from the thickest skewer against a trusted guide to doneness.",
      "time": {"from": 8, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/toast",
      "works_on": ["ingredient/pita-bread"],
      "with": [],
      "text": "Warm the {pita} on the grill for a short while, turning them once, until they are soft and lightly marked.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sandwich",
      "works_on": ["ingredient/pita-bread"],
      "with": ["ingredient/pork-tenderloin", "ingredient/tomato", "ingredient/onion", "ingredient/lemon"],
      "text": "Lay the {pita} flat. Slide the pork off the skewers onto each, add the {tomato} and the {onion}, squeeze over the {lemon} and fold the bread round the filling. Serve at once.",
      "time": null,
      "temperature": null,
      "safety_points": [],
