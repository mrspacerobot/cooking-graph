  "steps": [
    {
      "technique": "technique/fry-garlic-gently",
      "works_on": ["ingredient/garlic"],
      "with": ["ingredient/olive-oil"],
      "text": "Crush the {garlic} lightly with the flat of a knife. Put it in a wide pan with the {oil} and warm it over low heat until it is pale gold and the {oil} smells of it.",
      "time": {"from": 3, "to": 4, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
