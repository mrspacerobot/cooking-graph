  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/frying-pan", "equipment/colander", "equipment/tongs",
    "equipment/wooden-spoon", "equipment/grater", "equipment/chefs-knife", "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/render",
      "works_on": ["ingredient/guanciale"],
      "with": [],
      "text": "Put the {guanciale} in a cold, wide pan over medium-low heat and let the fat run, until the pieces are golden at the edges. Lift them out and keep the fat in the pan.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/rendered-fat"]
    },
    {
      "technique": "technique/make-a-tomato-sauce",
      "works_on": ["ingredient/tinned-tomatoes"],
      "with": [
        "ingredient/chilli", "ingredient/olive-oil", "ingredient/salt", "preparation/rendered-fat",
        "ingredient/guanciale"
      ],
      "text": "Add the {sauce.chilli} and the {sauce.olive-oil} to the fat, then the tomatoes, crushed, with a little {sauce.salt}. Let it bubble at a lively simmer, stirring and crushing the tomatoes, until the sauce is thick and the fat shines at the edge. Stir the {guanciale} back in.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/tomato-sauce"]
    },
    {
      "technique": "technique/boil-pasta",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Cook the {pasta} in a large pot of well-salted boiling {water}, and lift it out a little before it is ready, with a mug of the cooking {water} set aside.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/toss-pasta-with-sauce",
      "works_on": ["ingredient/spaghetti"],
      "with": ["preparation/tomato-sauce", "ingredient/water"],
      "text": "Lift the {pasta} straight into the pan with the sauce and toss over the heat, adding the cooking {water} a splash at a time, until the sauce turns glossy and clings.",
      "time": {"from": 1, "to": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/grate",
      "works_on": ["ingredient/pecorino"],
      "with": [],
      "text": "Grate the {cheese} and take half through the pasta off the heat.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/pecorino"],
      "text": "Serve in warm bowls with the rest of the cheese over the top.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
