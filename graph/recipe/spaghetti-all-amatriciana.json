    {"thing": "ingredient/chilli", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "sauce"},
    {"thing": "ingredient/olive-oil", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "sauce"},
    {"thing": "ingredient/salt", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "sauce"},
