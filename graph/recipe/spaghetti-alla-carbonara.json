  "steps": [
    {
      "technique": "technique/render",
      "works_on": ["ingredient/guanciale"],
      "with": [],
      "text": "Put the {pork}, cut into short, thick sticks with any hard rind taken off, in a cold, dry frying pan and set it over low heat. Let the fat melt out slowly, stirring now and then, until the pieces are golden and crisp and sit in clear fat. Take the pan off the heat.",
      "time": {"from": 8, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/rendered-fat"]
    },
    {
      "technique": "technique/boil-pasta",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Bring a large pot of {water} to a rolling boil and {salt} it well. Cook the {pasta} until it is tender with a firm bite at the centre. Before draining, scoop out a mug of the cooking {water}.",
      "time": {"from": 9, "to": 11, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/whisk",
      "works_on": ["ingredient/egg"],
      "with": ["ingredient/egg-yolk", "ingredient/pecorino", "ingredient/black-pepper"],
      "text": "In a bowl, whisk the {egg.egg} and the yolks with most of the grated {cheese} and plenty of freshly ground {pepper} into a thick, pale paste.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/emulsify-off-the-heat",
      "works_on": ["ingredient/egg"],
      "with": ["ingredient/egg-yolk", "ingredient/pecorino", "preparation/rendered-fat", "ingredient/water"],
      "text": "Keep the pan off the heat. Loosen the {egg.egg} mixture with a splash of the hot cooking {water} and a spoonful of the rendered fat, stirring, until it is a smooth, pourable cream with no streaks.",
      "time": null,
      "temperature": null,
      "safety_points": ["raw-or-lightly-cooked-egg"],
      "makes": []
    },
    {
      "technique": "technique/toss-pasta-with-sauce",
      "works_on": ["ingredient/spaghetti"],
      "with": [
        "ingredient/guanciale", "preparation/rendered-fat", "ingredient/egg", "ingredient/egg-yolk",
        "ingredient/pecorino", "ingredient/water"
      ],
      "text": "Lift the {pasta} straight into the pan with the {pork} and its fat, off the heat. Pour in the {egg.egg} cream and toss quickly, adding more cooking {water} a splash at a time, until it turns glossy and clings to every strand. Do not return the pan to the heat.",
      "time": null,
      "temperature": null,
      "safety_points": ["raw-or-lightly-cooked-egg"],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/black-pepper"],
      "text": "Taste, and add more {pepper} if it is wanted.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/pecorino"],
      "text": "Twirl the {pasta} into warm bowls and scatter over the rest of the {cheese} and a little more {pepper}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
