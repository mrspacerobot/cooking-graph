      "with": ["ingredient/black-olive", "ingredient/capers", "ingredient/olive-oil", "ingredient/garlic"],
      "text": "Add the {tomato:plural}, the {olives} and the {capers:plural}, crushing the {tomato:plural} with the spoon. Simmer briskly, stirring now and then, until the sauce is thick. Taste before adding any {salt}: the sauce is salty already.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/tomato-sauce"]
    },
    {
