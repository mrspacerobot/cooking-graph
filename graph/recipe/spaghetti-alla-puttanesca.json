      "works_on": ["ingredient/garlic"],
      "with": ["ingredient/olive-oil", "ingredient/dried-red-chilli"],
      "text": "Put the {oil}, the sliced {garlic} and the crumbled {chilli} in a wide pan and warm them over low heat until the {garlic} is pale gold.",
      "time": {"from": 3, "to": 4, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/melt-anchovies",
      "works_on": ["ingredient/anchovy"],
      "with": ["ingredient/olive-oil"],
      "text": "[anchovy: Add the {anchovy:plural} and press them with a wooden spoon until they melt into the {oil}.]",
      "time": {"from": 1, "to": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/make-a-tomato-sauce",
