      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Bring a large pot of {water} to a rolling boil and season it well with the {salt}. Cook the {pasta} until it is tender with a firm bite at the centre. Scoop out a mug of the cooking {water} before draining.",
      "time": {"from": 9, "to": 11, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/chop",
      "works_on": ["ingredient/parsley"],
      "with": [],
      "text": "[parsley: Chop the leaves of the {parsley} finely.]",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
