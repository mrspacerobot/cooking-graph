      "works_on": ["ingredient/spaghetti"],
      "with": ["preparation/tomato-sauce", "ingredient/water"],
      "text": "Lift the {pasta} into the sauce with a splash of the cooking {water} and toss over the heat until the sauce clings to every strand.",
      "time": {"from": 1, "to": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/parsley"],
      "text": "Serve in warm bowls[parsley: , scattered with the {parsley}].",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
