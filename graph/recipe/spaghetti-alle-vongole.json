{
  "id": "recipe/spaghetti-alle-vongole",
  "tier": "drafted",
  "names": {"en": "Spaghetti alle vongole", "fr": "Spaghetti aux palourdes"},
  "aliases": {},
  "makes": "dish/spaghetti-alle-vongole",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/spaghetti", "amount": {"value": 320, "unit": "gram"}, "forms": [], "part": "pasta"},
    {"thing": "ingredient/clam", "amount": {"value": 1, "unit": "kilogram"}, "forms": [], "part": "clam"},
    {"thing": "ingredient/garlic", "amount": {"value": 3, "unit": "clove"}, "forms": ["form/sliced"], "part": "garlic"},
    {"thing": "ingredient/chilli", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "chilli"},
    {"thing": "ingredient/olive-oil", "amount": {"value": 4, "unit": "tablespoon"}, "forms": [], "part": "oil"},
    {"thing": "ingredient/white-wine", "amount": {"value": 100, "unit": "millilitre"}, "forms": [], "part": "wine"},
    {
      "thing": "ingredient/parsley",
      "amount": {"value": 20, "unit": "gram"},
      "forms": ["form/chopped"],
      "part": "parsley"
    },
    {"thing": "ingredient/water", "amount": {"value": 3, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/salt", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/water", "amount": {"value": 1, "unit": "litre"}, "forms": [], "part": "water"},
    {"thing": "ingredient/salt", "amount": {"value": 2, "unit": "tablespoon"}, "forms": [], "part": "salt"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/saute-pan", "equipment/mixing-bowl",
    "equipment/slotted-spoon", "equipment/tongs", "equipment/chefs-knife", "equipment/cutting-board"
  ],
  "steps": [
    {
      "technique": "technique/purge-clams",
      "works_on": ["ingredient/clam"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Look over the {clam} and throw away any that are broken or that stay open when tapped. Stir the {salt} into the cold {water} until it tastes like the sea, lay the {clam} in it in a single layer and leave them in a cool place so that they spit out their sand. Lift them out by hand and leave the grit behind.",
      "time": {"from": 30, "to": 60, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/garlic"],
      "with": ["ingredient/olive-oil", "ingredient/chilli"],
      "text": "Warm the {oil} in a wide pan with the {garlic} and the {chilli} over low heat, until the {garlic} is fragrant and just pale. It must not brown.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/steam",
      "works_on": ["ingredient/clam"],
      "with": ["ingredient/white-wine"],
      "text": "Tip in the {clam} with the {wine}, cover at once and shake the pan now and then. Take the pan off the heat as soon as the shells have opened, and throw away any {clam} that stays shut. Keep the pan juices.",
      "time": {"from": 4, "to": 6, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/boil-pasta",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Cook the {pasta} in a large pot of well-salted boiling {water}, and lift it out a little before it is ready, with a mug of the cooking {water} set aside.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/chop",
      "works_on": ["ingredient/parsley"],
      "with": [],
      "text": "Chop the {parsley}.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/toss-pasta-with-sauce",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/clam", "ingredient/parsley", "ingredient/garlic"],
      "text": "Lift the {pasta} straight into the pan with the {clam} and their juices and toss over medium heat, adding a splash of the cooking {water} at a time, until the sauce turns glossy and clings. Scatter in the {parsley}.",
      "time": {"from": 1, "to": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/spaghetti"],
      "with": [],
      "text": "Taste, and add the {salt} only if the juices need it. The {clam} is already salty.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/spaghetti"],
      "with": ["ingredient/clam"],
      "text": "Serve at once in warm bowls, with the {clam} on top and the juices poured over.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
