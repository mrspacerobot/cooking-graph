  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/mixing-bowl", "equipment/whisk", "equipment/ladle",
    "equipment/chefs-knife", "equipment/cutting-board", "equipment/baking-sheet"
  ],
  "steps": [
    {
      "technique": "technique/mince",
      "works_on": ["ingredient/onion"],
      "with": [],
      "text": "Mince the {onion} very finely.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/knead",
      "works_on": ["ingredient/minced-beef"],
      "with": ["ingredient/rice", "ingredient/onion", "ingredient/salt", "ingredient/black-pepper"],
      "text": "Rinse the {rice}. Work the meat with the {onion}, the {rice}, half of the {salt} and the {black-pepper} until it is sticky and holds together.",
      "time": null,
      "temperature": null,
      "safety_points": ["raw-meat-or-fish"],
      "makes": []
    },
    {
      "technique": "technique/shape-meatballs",
      "works_on": ["ingredient/minced-beef"],
      "with": ["ingredient/flour"],
      "text": "Roll the mixture into hazelnut-sized balls and roll them in the {coating} on a tray, so that they do not stick together.",
      "time": null,
      "temperature": null,
      "safety_points": ["raw-meat-or-fish"],
      "makes": []
    },
    {
      "technique": "technique/dice",
      "works_on": ["ingredient/potato", "ingredient/carrot"],
      "with": [],
      "text": "Dice the {potato:plural} and the {carrot} small.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fry-tomato-paste",
      "works_on": ["ingredient/tomato-paste"],
      "with": ["ingredient/butter"],
      "text": "Melt the {butter} in a large pot and fry the {paste} in it, stirring, until it darkens a shade.",
      "time": {"from": 1, "to": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/potato", "ingredient/carrot", "ingredient/minced-beef"],
      "with": ["ingredient/water", "ingredient/salt", "ingredient/rice"],
      "text": "Pour in the {water}, add the rest of the {salt} and bring it to the boil. Add the {carrot} and the {potato:plural}, then drop in the meatballs, shaking off the extra {coating}. Simmer gently, half covered, until the {rice} in the meatballs and the {potato:plural} are soft. Check a meatball against a trusted guide to doneness.",
      "time": {"from": 25, "to": 30, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/temper",
      "works_on": ["ingredient/egg"],
      "with": ["ingredient/lemon", "ingredient/flour", "ingredient/water"],
      "text": "In a bowl, whisk the {egg} with the juice of the {lemon} and the {thickener} until smooth. Whisk in a ladle of the hot broth, then another, and pour the mixture back into the pot, stirring. Keep it just below the boil until it thickens a little.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/minced-beef"],
      "with": ["ingredient/dried-mint"],
      "text": "Crumble the {mint} over the soup and serve it hot.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
