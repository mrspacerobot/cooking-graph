      "works_on": ["ingredient/potato", "ingredient/chicken-thigh"],
      "with": ["preparation/braising-liquid"],
      "text": "Tuck the {potato:plural} in around the {chicken}, spoon the sauce over them, cover and cook on until the {potato:plural} are tender and the {chicken} comes away from the bone. Check the thickest piece against a trusted guide to doneness.",
      "time": {"from": 25, "to": 30, "unit": "minute"},
