      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/deglaze",
      "works_on": ["preparation/fond", "ingredient/white-wine"],
      "text": "Add the wine, scrape the pan and let the wine boil away almost completely.",
      "time": {"value": 2, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
