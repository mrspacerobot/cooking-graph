  "steps": [
    {
      "technique": "technique/cook-rice",
      "works_on": [],
      "with": ["ingredient/jasmine-rice", "ingredient/water"],
      "text": "Rinse the {rice} well in a sieve, drain it, and put it in a pan with the {rice-water}. Bring it to a boil, cover, turn the heat to its lowest and cook until the {rice-water} is taken up. Leave it covered off the heat until you serve.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cut-into-small-pieces",
      "works_on": ["ingredient/chicken-thigh"],
      "with": [],
      "text": "Cut the {chicken} into bite-sized pieces.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/dice",
      "works_on": ["ingredient/aubergine"],
      "with": [],
      "text": "Cut the {aubergine} into large dice.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fry-the-paste",
      "works_on": ["ingredient/green-curry-paste"],
      "with": ["ingredient/oil", "ingredient/coconut-milk"],
      "text": "Heat the {oil} with the thick cream from the top of the {coconut-milk} in a wok and let it bubble until it starts to split and look oily. Add the {paste} and fry, stirring, until it smells strongly fragrant. Most home cooks use a bought {paste}; brands vary in heat, so start with less and add more.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/chicken-thigh", "ingredient/aubergine"],
      "with": ["ingredient/coconut-milk", "ingredient/makrut-lime-leaf"],
      "text": "Add the {chicken} and stir to coat, then pour in the rest of the {coconut-milk} [lime-leaf: and add the torn {lime-leaf:plural}]. Bring to a simmer, add the {aubergine} and cook gently until the vegetables are soft and the {chicken} is tender. Check a piece of {chicken} against a trusted guide to doneness.",
      "time": {"from": 12, "to": 15, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/chicken-thigh"],
      "with": ["ingredient/fish-sauce", "ingredient/palm-sugar"],
      "text": "Season with the {fish-sauce} and the {sugar}, tasting as you go: it should be hot, salty and only a little sweet.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
