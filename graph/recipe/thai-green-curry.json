      "works_on": ["ingredient/chicken-thigh"],
      "with": ["ingredient/thai-basil", "ingredient/birds-eye-chilli", "ingredient/jasmine-rice"],
      "text": "Take the pan off the heat and stir in the {basil}[chilli: , then scatter over the sliced {chilli}]. Serve with the {rice}.",
      "time": null,
      "temperature": null,
