      "with": ["ingredient/sour-cream", "ingredient/avocado"],
      "text": "Pile the tinga onto the {tortillas:plural}. [cream: Top with the {cream}.] [avocado: Add slices of {avocado}.]",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
