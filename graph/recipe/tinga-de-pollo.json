    {"thing": "ingredient/chipotle-in-adobo", "amount": {"value": 3, "unit": "piece"}, "forms": [], "part": "chipotle"},
    {"thing": "ingredient/garlic", "amount": {"value": 2, "unit": "clove"}, "forms": [], "part": "garlic"},
