        "preparation/poaching-liquid"
      ],
      "text": "Blend the {tomato}, the {chipotle:plural} with a spoonful of the sauce from their tin, the {garlic}[oregano: , the {oregano}] and a ladle of the poaching liquid until smooth.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fry-the-sauce",
      "works_on": ["ingredient/tinned-tomatoes"],
      "with": [],
      "text": "Pour the sauce over the {onion:plural}, standing back as it spits, and let it bubble and darken, stirring.",
      "time": {"from": 4, "to": 5, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/chicken-breast"],
      "with": ["preparation/poaching-liquid", "ingredient/salt"],
      "text": "Stir in the {chicken}, add a little more poaching liquid if it looks dry, and simmer until the sauce clings to the shreds. Taste and adjust the {salt}.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/griddle",
      "works_on": ["ingredient/corn-tortilla"],
      "with": [],
      "text": "Warm the {tortillas:plural} one at a time in a hot dry pan until soft and spotted.",
      "time": {"from": 30, "to": 60, "unit": "second"},
      "temperature": null,
      "safety_points": [],
      "makes": []
