  "steps": [
    {
      "technique": "technique/poach",
      "works_on": ["ingredient/chicken-breast"],
      "with": ["ingredient/water", "ingredient/salt"],
      "text": "Put the {chicken} in a pan, cover with cold {water}, add a little of the {salt} and bring to a bare simmer. Poach gently until the meat is just firm. Check the thickest piece against a trusted guide to doneness. Keep the poaching liquid.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": ["doneness"],
      "makes": ["preparation/poaching-liquid"]
    },
    {
      "technique": "technique/shred-meat",
      "works_on": ["ingredient/chicken-breast"],
      "with": [],
      "text": "Let it cool a little, then pull it into shreds with a pair of forks.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/slice",
      "works_on": ["ingredient/onion"],
      "with": [],
      "text": "Halve the {onion:plural} and slice them thinly.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/saute",
      "works_on": ["ingredient/onion"],
      "with": ["ingredient/oil"],
      "text": "Heat the {oil} in a wide pan and fry the {onion:plural} over medium heat until soft and golden at the edges.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/puree",
      "works_on": ["ingredient/garlic"],
      "with": [
