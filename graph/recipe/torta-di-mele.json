      "works_on": ["ingredient/egg"],
      "with": ["ingredient/sugar", "ingredient/salt", "ingredient/lemon"],
      "text": "Whisk the {egg:plural} with the {sugar}, the {salt} and the grated zest of the {lemon} until pale, thick and greatly increased, so the mixture falls from the whisk in a ribbon.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/stir",
      "works_on": ["ingredient/milk"],
      "with": ["ingredient/butter"],
      "text": "Stir in the {milk} and the melted {butter} gently.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/fold",
      "works_on": [],
      "with": ["ingredient/flour", "ingredient/baking-powder"],
      "text": "Sift the {flour} with the {baking-powder} over the mixture and fold it in gently with a spatula until no dry streaks are left.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/layer",
      "works_on": [],
      "with": ["ingredient/apple", "ingredient/sugar"],
      "text": "Fold about half the {apple:plural} into the batter and pour it into the tin. Arrange the rest in overlapping circles on top[topping: and scatter over the {topping}].",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/bake",
      "works_on": [],
      "with": [],
      "text": "Bake in the middle of the oven until risen and golden and a skewer pushed into the middle comes out clean.",
      "time": {"from": 45, "to": 50, "unit": "minute"},
      "temperature": {"value": 180, "unit": "celsius"},
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/apple"],
      "with": [],
      "text": "Leave the cake to cool in the tin for a while, then turn it out onto a rack. Serve warm or cold.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
