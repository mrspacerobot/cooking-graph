  "steps": [
    {
      "technique": "technique/melt",
      "works_on": ["ingredient/butter"],
      "with": [],
      "text": "Heat the oven. Melt the {butter} and let it cool a little. Brush a little of it round a cake tin and line the base with baking paper.",
      "time": {"from": 2, "to": 3, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/core",
      "works_on": ["ingredient/apple"],
      "with": [],
      "text": "Peel the {apple:plural}, cut them into quarters and cut out the cores.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/slice",
      "works_on": [],
      "with": ["ingredient/apple", "ingredient/lemon"],
      "text": "Cut the quarters into thin slices and turn them in a little juice from the {lemon} so they stay pale.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
