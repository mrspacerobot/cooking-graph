{
  "id": "recipe/vegetable-biryani",
  "tier": "drafted",
  "names": {"en": "Vegetable biryani"},
  "aliases": {},
  "makes": "dish/vegetable-biryani",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {
      "thing": "ingredient/potato",
      "amount": {"value": 250, "unit": "gram"},
      "forms": ["form/large-pieces"],
      "part": "vegetables"
    },
    {
      "thing": "ingredient/carrot",
      "amount": {"value": 150, "unit": "gram"},
      "forms": ["form/diced"],
      "part": "vegetables"
    },
    {
      "thing": "ingredient/cauliflower",
      "amount": {"value": 250, "unit": "gram"},
      "forms": ["form/large-pieces"],
      "part": "vegetables"
    },
    {"thing": "ingredient/peas", "amount": {"value": 100, "unit": "gram"}, "forms": [], "part": "vegetables"},
    {"thing": "ingredient/basmati-rice", "amount": {"value": 300, "unit": "gram"}, "forms": [], "part": "rice"},
    {"thing": "ingredient/plain-yogurt", "amount": {"value": 150, "unit": "gram"}, "forms": [], "part": "yogurt"},
    {
      "thing": "ingredient/kashmiri-red-chilli-powder",
      "amount": {"value": 1, "unit": "teaspoon"},
      "forms": [],
      "part": "paste"
    },
    {"thing": "ingredient/turmeric", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": [], "part": "paste"},
    {"thing": "preparation/garam-masala", "amount": {"value": 1, "unit": "teaspoon"}, "forms": [], "part": "paste"},
    {"thing": "ingredient/garlic", "amount": {"value": 5, "unit": "clove"}, "forms": ["form/minced"], "part": "paste"},
    {"thing": "ingredient/ginger", "amount": {"value": 25, "unit": "gram"}, "forms": ["form/grated"], "part": "paste"},
    {
      "thing": "ingredient/green-chilli",
      "amount": {"value": 2, "unit": "piece"},
      "forms": ["form/sliced"],
      "part": "paste"
    },
    {"thing": "ingredient/lemon-juice", "amount": {"value": 1, "unit": "tablespoon"}, "forms": [], "part": "paste"},
    {"thing": "ingredient/tomato", "amount": {"value": 2, "unit": "piece"}, "forms": ["form/diced"], "part": "tomato"},
    {"thing": "ingredient/ghee", "amount": {"value": 2, "unit": "tablespoon"}, "forms": [], "part": "masala-fat"},
    {
      "thing": "ingredient/onion",
      "amount": {"value": 3, "unit": "piece"},
      "forms": ["form/sliced"],
      "part": "fried-onions"
    },
    {"thing": "ingredient/oil", "amount": {"value": 120, "unit": "millilitre"}, "forms": [], "part": "fried-onions"},
    {"thing": "ingredient/water", "amount": {"value": 2, "unit": "litre"}, "forms": [], "part": "rice-water"},
    {"thing": "ingredient/cardamom", "amount": {"value": 4, "unit": "piece"}, "forms": [], "part": "cardamom"},
    {"thing": "ingredient/cinnamon", "amount": {"value": 1, "unit": "piece"}, "forms": [], "part": "cinnamon"},
    {"thing": "ingredient/clove", "amount": {"value": 4, "unit": "piece"}, "forms": [], "part": "clove"},
    {"thing": "ingredient/bay-leaf", "amount": {"value": 2, "unit": "leaf"}, "forms": [], "part": "bay-leaf"},
    {"thing": "ingredient/saffron", "amount": {"value": 1, "unit": "pinch"}, "forms": [], "part": "saffron"},
    {"thing": "ingredient/milk", "amount": {"value": 60, "unit": "millilitre"}, "forms": [], "part": "milk"},
    {"thing": "ingredient/ghee", "amount": {"value": 3, "unit": "tablespoon"}, "forms": [], "part": "ghee"},
    {"thing": "ingredient/mint", "amount": {"value": 15, "unit": "gram"}, "forms": ["form/chopped"], "part": "mint"},
    {
      "thing": "ingredient/coriander-leaf",
      "amount": {"value": 15, "unit": "gram"},
      "forms": ["form/chopped"],
      "part": "coriander"
    },
    {"thing": "ingredient/salt", "amount": {"value": 3, "unit": "teaspoon"}, "forms": [], "part": "salt"},
    {"thing": "ingredient/flour", "amount": {"value": 100, "unit": "gram"}, "forms": [], "part": "seal-flour"},
    {"thing": "ingredient/water", "amount": {"value": 50, "unit": "millilitre"}, "forms": [], "part": "seal-water"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/handi", "equipment/tava", "equipment/colander",
    "equipment/saute-pan", "equipment/frying-pan", "equipment/slotted-spoon", "equipment/saucepan", "equipment/blender",
    "equipment/wooden-spoon"
  ],
  "steps": [
    {
      "technique": "technique/fry-onions-deep-brown",
      "works_on": ["ingredient/onion"],
      "with": ["ingredient/oil"],
      "text": "Fry the sliced {fried-onions.onion:plural} in the {fried-onions.oil} in a wide pan, stirring often, until they are deep brown. Lift them out onto paper, and they crisp as they cool.",
      "time": {"from": 20, "to": 30, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/fried-onions"]
    },
    {
      "technique": "technique/make-spice-paste",
      "works_on": [
        "ingredient/garlic", "ingredient/ginger", "ingredient/green-chilli", "ingredient/kashmiri-red-chilli-powder"
      ],
      "with": ["ingredient/turmeric", "preparation/garam-masala", "ingredient/lemon-juice", "ingredient/salt"],
      "text": "Blend the {paste.garlic}, {paste.ginger} and {paste.green-chilli} with the chilli powder, the {paste.turmeric}, the {paste.garam-masala}, the {paste.lemon-juice} and a little of the {salt} to a thick paste.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": ["preparation/spice-paste"]
    },
    {
      "technique": "technique/fry-masala-base",
      "works_on": ["ingredient/tomato", "preparation/spice-paste"],
      "with": ["ingredient/ghee"],
      "text": "Heat the {masala-fat} in a wide pan, stir in the paste and cook until the raw smell goes. Add the {tomato} and cook, stirring, until it has collapsed and the {masala-fat} parts from the paste.",
      "time": {"from": 8, "to": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-a-dry-vegetable-dish",
      "works_on": ["ingredient/potato", "ingredient/carrot", "ingredient/cauliflower"],
      "with": ["ingredient/plain-yogurt", "preparation/fried-onions", "ingredient/peas", "ingredient/salt"],
      "text": "Stir the {vegetables.potato}, the {vegetables.carrot}, the {vegetables.cauliflower} and the {yogurt} into the masala with a little of the crushed fried onions. Cover and cook over a low heat, stirring now and then, until the vegetables are almost tender and wrapped in a thick, spiced coat. Stir in the {vegetables.peas:plural} for the last part.",
      "time": {"from": 15, "to": 20, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/parboil-rice",
      "works_on": ["ingredient/basmati-rice"],
      "with": [
        "ingredient/water", "ingredient/salt", "ingredient/cardamom", "ingredient/cinnamon", "ingredient/clove",
        "ingredient/bay-leaf"
      ],
      "text": "Rinse the rice until the {rice-water} is nearly clear and soak it in cold {rice-water}. Boil it in a large pot of well-salted {rice-water} with the {cardamom}, the {cinnamon}, the {clove:plural} and the {bay-leaf} until each grain is nearly tender with a firm core. Drain it at once.",
      "time": {"from": 5, "to": 8, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/infuse",
      "works_on": ["ingredient/milk"],
      "with": ["ingredient/saffron"],
      "text": "Warm the {milk} gently and steep the {saffron} in it until the {milk} turns a deep gold.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/cook-on-dum",
      "works_on": ["ingredient/basmati-rice"],
      "with": [
        "ingredient/ghee", "ingredient/saffron", "ingredient/milk", "ingredient/mint", "ingredient/coriander-leaf",
        "preparation/fried-onions", "ingredient/flour", "ingredient/water", "ingredient/potato", "ingredient/carrot",
        "ingredient/cauliflower", "ingredient/peas"
      ],
      "text": "Spread the vegetable masala on the bottom of a heavy pot. Pile the rice over it in loose layers with the {mint}, the {coriander} and the rest of the fried onions, dot it with the {ghee} and pour the {saffron} {milk} over the top. Mix the {seal-flour} and the {seal-water} to a firm dough and press a rope of it round the rim so that the lid is sealed. Set the pot on an iron plate over a medium heat for a short spell, then turn the heat to its lowest and leave it undisturbed. Rest it before breaking the seal.",
      "time": {"from": 25, "to": 35, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/basmati-rice"],
      "with": [],
      "text": "Break the seal at the table. Dig down to the bottom with a flat spoon so that the vegetables and the rice come up together, and serve.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
