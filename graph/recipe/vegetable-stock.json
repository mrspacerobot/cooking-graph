{
  "id": "recipe/vegetable-stock",
  "tier": "drafted",
  "names": {"en": "Vegetable stock"},
  "aliases": {},
  "makes": "preparation/vegetable-stock",
  "yields": {"value": 1.5, "unit": "litre"},
  "ingredients": [
    {
      "thing": "ingredient/onion",
      "amount": {"value": 2, "unit": "piece"},
      "forms": ["form/peeled", "form/sliced"]
    },
    {
      "thing": "ingredient/carrot",
      "amount": {"value": 2, "unit": "piece"},
      "forms": ["form/peeled", "form/sliced"]
    },
    {
      "thing": "ingredient/celery",
      "amount": {"value": 2, "unit": "piece"},
      "forms": ["form/sliced"]
    },
    {"thing": "ingredient/leek", "amount": {"value": 1, "unit": "piece"}, "forms": ["form/sliced"]},
    {
      "thing": "ingredient/mushroom",
      "amount": {"value": 100, "unit": "gram"},
      "forms": ["form/sliced"]
    },
    {"thing": "preparation/bouquet-garni", "amount": {"value": 1, "unit": "piece"}, "forms": []},
    {"thing": "ingredient/olive-oil", "amount": {"value": 1, "unit": "tablespoon"}, "forms": []},
    {"thing": "ingredient/black-pepper", "amount": {"value": 0.5, "unit": "teaspoon"}, "forms": []},
    {"thing": "ingredient/water", "amount": {"value": 2, "unit": "litre"}, "forms": []}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/stockpot", "equipment/fine-sieve", "equipment/ladle",
    "equipment/mixing-bowl"
  ],
  "steps": [
    {
      "technique": "technique/sweat",
      "works_on": [
        "ingredient/olive-oil", "ingredient/onion", "ingredient/carrot", "ingredient/celery",
        "ingredient/leek", "ingredient/mushroom"
      ],
      "text": "Sweat all the vegetables in the oil over low heat until soft and fragrant, without colour.",
      "time": {"value": 10, "unit": "minute"},
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/water", "preparation/bouquet-garni", "ingredient/black-pepper"],
      "text": "Add the cold water, the bouquet garni and the pepper. Bring to a simmer and cook gently, uncovered. A vegetable stock gives all it has quickly, and turns dull if it cooks much longer.",
      "time": {"from": 40, "to": 45, "unit": "minute"},
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/strain",
      "works_on": ["preparation/vegetable-stock"],
      "text": "Ladle the stock through a fine sieve and let the vegetables drain without pressing on them.",
      "time": null,
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/chill",
      "works_on": ["preparation/vegetable-stock"],
      "text": "Use it at once, or cool it quickly in a bowl set in iced water and keep it in the fridge.",
      "time": null,
      "temperature": null,
      "safety_points": ["cooling-and-keeping"]
    }
  ]
}
