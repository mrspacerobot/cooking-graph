{
  "id": "recipe/vichyssoise",
  "tier": "drafted",
  "names": {"en": "Vichyssoise"},
  "aliases": {},
  "makes": "dish/vichyssoise",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/leek", "amount": {"value": 400, "unit": "gram"}, "forms": ["form/sliced"], "part": "leek"},
    {
      "thing": "ingredient/potato",
      "amount": {"value": 300, "unit": "gram"},
      "forms": ["form/peeled", "form/diced"],
      "part": "potato"
    },
    {"thing": "ingredient/butter", "amount": {"value": 40, "unit": "gram"}, "forms": [], "part": "butter"},
    {"thing": "preparation/white-chicken-stock", "amount": {"value": 1, "unit": "litre"}, "forms": [], "part": "stock"},
    {"thing": "ingredient/cream", "amount": {"value": 200, "unit": "millilitre"}, "forms": [], "part": "cream"},
    {
      "thing": "ingredient/chives",
      "amount": {"value": 1, "unit": "tablespoon"},
      "forms": ["form/chopped"],
      "part": "chives"
    },
    {"thing": "ingredient/salt", "amount": {"value": 1.5, "unit": "teaspoon"}, "forms": [], "part": "salt"}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/saucepan", "equipment/blender", "equipment/fine-sieve", "equipment/mixing-bowl"
  ],
  "steps": [
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/leek"],
      "with": ["ingredient/butter", "ingredient/salt"],
      "text": "Wash the sliced {leek:plural} well and drain them. Sweat them in the {butter} with a little of the {salt} over low heat, covered, until soft. They must not colour.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/potato"],
      "with": ["preparation/white-chicken-stock"],
      "text": "Add the {potato:plural} and most of the {stock}. Bring to a simmer and cook until a piece of {potato} crushes easily against the side of the pan.",
      "time": {"from": 20, "to": 25, "unit": "minute"},
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/puree",
      "works_on": ["ingredient/leek", "ingredient/potato"],
      "with": [],
      "text": "Blend the soup in short bursts, in batches, only until it is smooth, and pass it through a fine sieve. Long blending turns {potato} to glue.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/chill",
      "works_on": ["ingredient/leek", "ingredient/potato"],
      "with": ["ingredient/cream"],
      "text": "Stir in the {cream}. Cool the soup quickly in a bowl set in iced water, then chill it until really cold.",
      "time": {"value": 3, "unit": "hour"},
      "temperature": null,
      "safety_points": ["cooling-and-keeping"],
      "makes": []
    },
    {
      "technique": "technique/season",
      "works_on": ["preparation/white-chicken-stock"],
      "with": ["ingredient/salt"],
      "text": "Taste it cold and add the rest of the {salt}: cold dulls seasoning. Thin it with the cold {stock} you kept back if it has set too thick.",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    },
    {
      "technique": "technique/plate",
      "works_on": [],
      "with": ["ingredient/chives"],
      "text": "Ladle into chilled bowls [chives: and scatter with the {chives:plural}].",
      "time": null,
      "temperature": null,
      "safety_points": [],
      "makes": []
    }
  ]
}
