{
  "id": "recipe/vichyssoise",
  "tier": "drafted",
  "names": {"en": "Vichyssoise"},
  "aliases": {},
  "makes": "dish/vichyssoise",
  "yields": {"value": 4, "unit": "serving"},
  "ingredients": [
    {"thing": "ingredient/leek", "amount": {"value": 400, "unit": "gram"}, "forms": ["form/sliced"]},
    {"thing": "ingredient/potato", "amount": {"value": 300, "unit": "gram"}, "forms": ["form/peeled", "form/diced"]},
    {"thing": "ingredient/butter", "amount": {"value": 40, "unit": "gram"}, "forms": []},
    {"thing": "preparation/white-chicken-stock", "amount": {"value": 1, "unit": "litre"}, "forms": []},
    {"thing": "ingredient/cream", "amount": {"value": 200, "unit": "millilitre"}, "forms": []},
    {"thing": "ingredient/chives", "amount": {"value": 1, "unit": "tablespoon"}, "forms": ["form/chopped"]},
    {"thing": "ingredient/salt", "amount": {"value": 1.5, "unit": "teaspoon"}, "forms": []}
  ],
  "equipment": [
    "equipment/stovetop", "equipment/saucepan", "equipment/blender", "equipment/fine-sieve", "equipment/mixing-bowl"
  ],
  "steps": [
    {
      "technique": "technique/sweat",
      "works_on": ["ingredient/butter", "ingredient/leek", "ingredient/salt"],
      "text": "Wash the sliced leeks well and drain them. Sweat them in the butter with a little of the salt over low heat, covered, until soft. They must not colour.",
      "time": {"from": 10, "to": 12, "unit": "minute"},
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/simmer",
      "works_on": ["ingredient/potato", "preparation/white-chicken-stock"],
      "text": "Add the potatoes and most of the stock. Bring to a simmer and cook until a piece of potato crushes easily against the side of the pan.",
      "time": {"from": 20, "to": 25, "unit": "minute"},
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/puree",
      "works_on": ["ingredient/leek", "ingredient/potato"],
      "text": "Blend the soup in short bursts, in batches, only until it is smooth, and pass it through a fine sieve. Long blending turns potato to glue.",
      "time": null,
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/chill",
      "works_on": ["ingredient/cream"],
      "text": "Stir in the cream. Cool the soup quickly in a bowl set in iced water, then chill it until really cold.",
      "time": {"value": 3, "unit": "hour"},
      "temperature": null,
      "safety_points": ["cooling-and-keeping"]
    },
    {
      "technique": "technique/season",
      "works_on": ["ingredient/salt", "preparation/white-chicken-stock"],
      "text": "Taste it cold and add the rest of the salt: cold dulls seasoning. Thin it with the cold stock you kept back if it has set too thick.",
      "time": null,
      "temperature": null,
      "safety_points": []
    },
    {
      "technique": "technique/plate",
      "works_on": ["ingredient/chives"],
      "text": "Ladle into chilled bowls and scatter with the chives.",
      "time": null,
      "temperature": null,
      "safety_points": []
    }
  ]
}
