#!/usr/bin/env python3
"""merge: copy new graph files from another checkout, refusing any that clash.

./merge <other-checkout>             copy
./merge <other-checkout> --dry-run   only say what would happen
"""

import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from tools import merge  # noqa: E402

arguments = sys.argv[1:]
if not arguments:
    sys.exit(__doc__)
result = merge.merge(os.path.abspath(arguments[0]), ROOT, dry_run="--dry-run" in arguments)
verb = "would copy" if "--dry-run" in arguments else "copied"
print("merge: %s %d new files" % (verb, len(result.copied)))
for relative, why in result.refused:
    print("refused %s: %s" % (relative, why))
for relative in result.changed:
    print("differs, left alone: " + relative)
print("merge: %d refused, %d existing files differ" % (len(result.refused), len(result.changed)))
sys.exit(1 if result.refused else 0)
