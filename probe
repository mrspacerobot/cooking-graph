#!/usr/bin/env python3
"""probe: run the dish probes against the graph and list what the graph lacks."""

import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from tools import check, probes  # noqa: E402

things, issues = check.read_repository(ROOT)
if issues:
    print("probe: ./check finds %d issues. Files with a wrong shape are left out of this run." % len(issues))
print(probes.report(probes.run(things)))
