#!/usr/bin/env python3
"""probe: run the dish probes against the graph and list what the graph lacks.

./probe                     every batch
./probe fresh-1             one batch alone
./probe --cuisine japanese  one cuisine alone
./probe reset-sets          put every probe in the set the rule gives; prints a count and no probe
"""

import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from tools import check, probe_rules, probes, question_probes  # noqa: E402

things, issues = check.read_repository(ROOT)
if issues:
    print("probe: ./check finds %d issues. Files with a wrong shape are left out of this run." % len(issues))
arguments = sys.argv[1:]
if arguments and arguments[0] == "reset-sets":
    print("probe: %d probes moved to the set the rule gives" % probe_rules.reset_sets(ROOT, things))
elif arguments and arguments[0] == "questions":
    if issues:
        sys.exit(1)
    batch = arguments[1] if len(arguments) > 1 else None
    print(question_probes.report(question_probes.run(things, batch=batch)))
elif arguments and arguments[0] == "--cuisine":
    cuisine = arguments[1] if len(arguments) > 1 else None
    print(probes.report(probes.run(things, cuisine=cuisine)))
else:
    batch = arguments[0] if arguments else None
    print(probes.report(probes.run(things, batch=batch)))
