#!/usr/bin/env python3
"""safety: run the safety probes.

./safety                 the counts
./safety disagreements   every disagreement of a growing probe with both sides, as Markdown
./safety strict          every answer that is strict and not certain, as Markdown
"""

import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from tools import check, safety_probes, written_documents  # noqa: E402

things, issues = check.read_repository(ROOT)
result = safety_probes.run(things)
written = {word: make for word, make in written_documents.DOCUMENTS.values()}
if len(sys.argv) == 2 and sys.argv[1] in written:
    print(written[sys.argv[1]](things), end="")
else:
    if issues:
        print("safety: ./check finds %d issues. Files with a wrong shape are left out of this run." % len(issues))
    print(safety_probes.report(result))
