#!/usr/bin/env python3
"""twins: list things that are probably one thing under two names. It never blocks.

./twins
"""

import json
import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from tools import check, twins  # noqa: E402

things, issues = check.read_repository(ROOT)
if issues:
    print("twins: ./check finds %d issues. Files with a wrong shape are left out of this run." % len(issues))
path = os.path.join(ROOT, "schema", "synonyms.json")
synonyms = []
if os.path.exists(path):
    with open(path, encoding="utf-8") as handle:
        synonyms = json.load(handle)
pairs = twins.find(things, synonyms)
for line in twins.report(pairs):
    print(line)
print("twins: %d pairs to read. A pair may be two different things." % len(pairs))
