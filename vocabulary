#!/usr/bin/env python3
"""vocabulary: the closed list of foods and techniques a photo step chooses from. It writes nothing.

./vocabulary          JSON: every ingredient and preparation, and every technique, with name, aliases and groups
./vocabulary --names  one line per id and English name
"""

import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from tools import check, vocabulary  # noqa: E402

parser = argparse.ArgumentParser(prog="vocabulary", description="The closed list a photo step chooses from. Graph only, never a probe.")
parser.add_argument("--names", action="store_true", help="one line per id and English name")
args = parser.parse_args()

things, issues = check.read_repository(ROOT)
if issues:
    print("vocabulary: ./check finds %d issues" % len(issues), file=sys.stderr)
    sys.exit(1)
listed = vocabulary.closed_list(things)
if args.names:
    print("\n".join(vocabulary.as_names(listed)))
else:
    print(json.dumps(listed, ensure_ascii=False, sort_keys=True, indent=2))
