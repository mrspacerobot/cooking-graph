#!/usr/bin/env python3
"""wikidata: give our ingredients, preparations and dishes their Wikidata id and names in other languages.

./wikidata --dry-run                 ask Wikidata, print what would change, write nothing
./wikidata --dry-run --save raw.json keep the answer so that it can be read again
./wikidata --from raw.json           use a kept answer and write the changes
./wikidata                           ask Wikidata and write the changes
./wikidata --propose --save raw.json  for things with no id: ask for items of any class and print the ones whose description
                                     sounds like a food, to be read. Writes nothing. A person then lists the chosen ones in
                                     schema/wikidata-chosen.json, and the next run takes them.

Only exact English matches to a food are taken. A label with two items, an item for two things,
a name another thing holds, and a name in another script are skipped and listed.
"""

import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from tools import check, wikidata, wikidata_fetch  # noqa: E402
from tools.rules import SAME_AS_KINDS, of_kind  # noqa: E402

parser = argparse.ArgumentParser(prog="wikidata", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument("--dry-run", action="store_true", help="write nothing")
parser.add_argument("--save", help="keep the answer from Wikidata in this file")
parser.add_argument("--from", dest="source_file", nargs="+", help="read one or more kept answers instead of asking")
parser.add_argument("--propose", action="store_true", help="print items of any class that might be a thing with no id, and write nothing")
parser.add_argument("--languages", default="es,it,tr,fr", help="comma list of language tags to take names in")
parser.add_argument("--source", default="source/wikidata", help="the source record that licenses the import")
args = parser.parse_args()

things, issues = check.read_repository(ROOT)
if issues:
    print("wikidata: ./check finds %d issues; fix them first" % len(issues), file=sys.stderr)
    sys.exit(1)
languages = tuple(args.languages.split(","))
considered = [thing for kind in SAME_AS_KINDS for _, thing in of_kind(things, kind)]
if args.source_file:
    entities = []
    for path in args.source_file:
        with open(path, encoding="utf-8") as handle:
            entities.extend(json.load(handle))
elif args.propose:
    open_things = [thing for thing in considered if not thing.data["same_as"]]
    labels = sorted({name for thing in open_things for name in wikidata.all_english_names(thing.data)})

    def progress(done, total):
        print("asked %d of %d labels" % (done, total), file=sys.stderr)

    entities = wikidata_fetch.fetch(labels, languages, progress, any_class=True)
    if args.save:
        with open(args.save, "w", encoding="utf-8") as handle:
            json.dump(entities, handle, ensure_ascii=False, indent=1)
else:
    labels = sorted({name for thing in considered for name in wikidata.english_names(thing.data)})

    def progress(done, total):
        print("asked %d of %d labels" % (done, total), file=sys.stderr)

    entities = wikidata_fetch.fetch(labels, languages, progress)
    if args.save:
        with open(args.save, "w", encoding="utf-8") as handle:
            json.dump(entities, handle, ensure_ascii=False, indent=1)
if args.propose:
    found = wikidata.propose(things, entities)
    print("\n".join(wikidata.proposal_lines(found)))
    print("wikidata: %d proposals to read for %d things. Nothing was written." % (len(found), len({one.thing for one in found})))
    sys.exit(0)
try:
    refused_path = os.path.join(ROOT, "schema", "wikidata-refused.json")
    refused = []
    if os.path.exists(refused_path):
        with open(refused_path, encoding="utf-8") as handle:
            refused = json.load(handle)
    chosen_path = os.path.join(ROOT, "schema", "wikidata-chosen.json")
    chosen = []
    if os.path.exists(chosen_path):
        with open(chosen_path, encoding="utf-8") as handle:
            chosen = json.load(handle)
    the_plan = wikidata.plan(things, entities, args.source, languages, refused, chosen)
except ValueError as error:
    print("wikidata: %s" % error, file=sys.stderr)
    sys.exit(1)
print("\n".join(wikidata.report(the_plan, len(considered))))
changed = wikidata.apply(ROOT, things, the_plan, dry_run=args.dry_run)
print("wikidata: %d things %s" % (changed, "would change (dry run)" if args.dry_run else "changed. Run ./tidy and ./check."))
